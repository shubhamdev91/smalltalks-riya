<section class="di-wrap di-talks"><h1 class="di-talks-word">the talks</h1><p class="di-note">a little less filtered.</p><p>Small moments. Open conversations.</p><a class="di-button di-talks-start" href="#DesiTalks">{{ 'desi.talks.start' | t }} ↗</a>
<div data-topic-filter><div class="di-filter-bar" role="group" aria-label="{{ 'desi.talks.examples' | t }}"><button type="button" data-filter="all" aria-pressed="true">{{ 'desi.talks.all' | t }}</button><button type="button" data-filter="plot" aria-pressed="false">{{ 'desi.talks.plot' | t }}</button><button type="button" data-filter="wins" aria-pressed="false">{{ 'desi.talks.wins' | t }}</button><button type="button" data-filter="nails" aria-pressed="false">{{ 'desi.talks.nails' | t }}</button></div><p class="di-examples-label">{{ 'desi.talks.examples' | t }}</p>
{% for block in section.blocks %}<article class="di-talk-card" data-filter-item data-category="{{ block.settings.topic }}" {{ block.shopify_attributes }}><div class="di-talk-avatar" aria-hidden="true">{% render 'di-nail',index:block.settings.nail_index,row:0 %}</div><div><p class="di-talk-alias">{{ block.settings.alias | escape }}</p><h2>{{ block.settings.heading | escape }}</h2><p>{{ block.settings.body | escape }}</p></div></article>{% endfor %}<p class="di-example-disclaimer">{{ 'desi.talks.example_note' | t }}</p></div><h2>Start a talk</h2><p>Submissions are sent privately to Small Talk for review. This is a moderated inbox; public threads and replies aren’t available yet.</p>{% form 'contact',id:'DesiTalks' %}{% if form.posted_successfully? %}<p role="status" tabindex="-1">Your talk has been sent for review. Thank you for sharing a little of your world.</p>{% else %}{{ form.errors | default_errors }}<input name="contact[subject]" type="hidden" value="the talks — moderation submission"><label for="TalkAlias">Post as</label><input id="TalkAlias" name="contact[alias]" type="text" placeholder="Your chosen alias" required maxlength="32"><label for="TalkEmail">Email, for the moderation team only</label><input id="TalkEmail" name="contact[email]" type="email" autocomplete="email" required><label for="TalkTopic">Your topic</label><select name="contact[topic]" id="TalkTopic"><option>Plot twists</option><option>Tiny wins</option><option>Nail talk</option></select><label for="TalkTitle">Title</label><input id="TalkTitle" name="contact[title]" maxlength="100" required><label for="TalkBody">Your small talk</label><textarea id="TalkBody" name="contact[body]" maxlength="1500" rows="5" required></textarea><p>Keep it kind. Leave out real names, identifying details and private information. An alias does not make your submission anonymous to our team.</p><label class="di-check"><input type="checkbox" required name="contact[sharing_permission]" value="Approved alias and submission may be published after moderation">I agree that Small Talk may share my approved words and alias.</label><button class="di-button" type="submit">Send for review <span aria-hidden="true">↗</span></button>{% endif %}{% endform %}<details><summary>Community rules & reporting</summary><p>Be kind. No harassment, identifying details, advertising or private information. We can decline or remove submissions. To withdraw a submission or report a concern, contact the team with its title and alias.</p><a href="/pages/help">Contact the moderation team</a></details></section>
{% schema %}
{
  "name": "Talks",
  "settings": [],"blocks":[{"type":"example","name":"Example conversation","settings":[{"type":"text","id":"alias","label":"Example alias"},{"type":"text","id":"heading","label":"Title"},{"type":"textarea","id":"body","label":"Example text"},{"type":"select","id":"topic","label":"Topic","options":[{"value":"plot","label":"Plot twists"},{"value":"wins","label":"Tiny wins"},{"value":"nails","label":"Nail talk"}],"default":"plot"},{"type":"range","id":"nail_index","label":"Nail artwork column","min":0,"max":6,"step":1,"default":3}]}],
  "presets": [
    {
      "name": "Talks"
    }
  ]
}
{% endschema %}
