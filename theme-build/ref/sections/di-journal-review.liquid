{% if settings.di_review_mode %}<section class="di-wrap di-journal"><p class="di-eyebrow">04 /</p><h1>Journal</h1><p>Seven sets. So many stories.</p><div class="di-editorial-list">{% assign keys = 'on-me,brainwave,green-flag,shaadi-shift,diet-cherry,wild-card,pinky-promise' | split: ',' %}{% for key in keys %}{% assign c = shop.metaobjects.small_talk_campaign[key] %}<article style="--scene:{{ c.background.value }};--nails:url('{{ c.nail_art.value | image_url: width: 1800 }}')"><a class="di-editorial-image" href="/?view=desi-preview-story-{{ key }}" aria-label="Read {{ c.name.value | escape }}"><span class="di-editorial-nails" aria-hidden="true">{% render 'di-nail',index:c.motion_index.value,row:1 %}{% render 'di-nail',index:c.motion_index.value,row:0 %}{% render 'di-nail',index:c.motion_index.value,row:2 %}</span></a><div>{% if forloop.first %}<small class="di-eyebrow">Featured</small>{% endif %}<h2>{{ c.name.value | escape }}</h2><p>{{ c.headline.value | escape }}</p><p class="di-editorial-description">{{ c.short_description.value | escape }}</p><a href="/?view=desi-preview-story-{{ key }}">Read the story →</a></div></article>{% endfor %}</div></section>{% endif %}
{% schema %}{"name":"Journal draft preview","settings":[],"presets":[{"name":"Journal draft preview"}]}{% endschema %}
