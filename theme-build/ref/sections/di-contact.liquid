<section class="di-wrap di-help"><h1>{{ section.settings.heading | escape }}</h1><p>{{ section.settings.intro | escape }}</p><div data-help-search><label class="visually-hidden" for="HelpSearch-{{ section.id }}">{{ 'desi.help.search' | t }}</label><input id="HelpSearch-{{ section.id }}" type="search" data-help-input placeholder="{{ 'desi.help.search' | t }}"><h2 class="di-help-topics-title">{{ 'desi.help.topics' | t }}</h2><div class="di-help-topics"><a data-help-topic href="{% if shop.shipping_policy.body != blank %}{{ shop.shipping_policy.url }}{% else %}#DesiContact{% endif %}"><span aria-hidden="true">↗</span><div><strong>{{ 'desi.help.delivery' | t }}</strong><small>{{ 'desi.help.delivery_note' | t }}</small></div><span aria-hidden="true">›</span></a><a data-help-topic href="{% if shop.refund_policy.body != blank %}{{ shop.refund_policy.url }}{% else %}#DesiContact{% endif %}"><span aria-hidden="true">↶</span><div><strong>{{ 'desi.help.returns' | t }}</strong><small>{{ 'desi.help.returns_note' | t }}</small></div><span aria-hidden="true">›</span></a><a data-help-topic href="/pages/nail-guide"><span aria-hidden="true">✧</span><div><strong>{{ 'desi.help.fit' | t }}</strong><small>{{ 'desi.help.fit_note' | t }}</small></div><span aria-hidden="true">›</span></a><a data-help-topic href="#DesiContact"><span aria-hidden="true">□</span><div><strong>{{ 'desi.help.orders' | t }}</strong><small>{{ 'desi.help.orders_note' | t }}</small></div><span aria-hidden="true">›</span></a></div><p data-help-empty hidden role="status">{{ 'desi.help.empty' | t }}</p></div><div class="di-help-links" hidden><a href="/pages/nail-guide">Fit & application <span aria-hidden="true">↗</span></a>{% if shop.shipping_policy.body != blank %}<a href="{{ shop.shipping_policy.url }}">Delivery <span aria-hidden="true">↗</span></a>{% endif %}{% if shop.refund_policy.body != blank %}<a href="{{ shop.refund_policy.url }}">Returns <span aria-hidden="true">↗</span></a>{% endif %}</div><h2>Still need help?</h2>{% form 'contact',id:'DesiContact' %}{% if form.posted_successfully? %}<p role="status" tabindex="-1">Thank you. Your message has been sent to Small Talk.</p>{% else %}{{ form.errors | default_errors }}<label for="HelpName">Name</label><input id="HelpName" name="contact[name]" type="text" autocomplete="name"><label for="HelpEmail">Email</label><input id="HelpEmail" name="contact[email]" type="email" autocomplete="email" required><label for="HelpTopic">What can we help with?</label><select id="HelpTopic" name="contact[topic]"><option>Choosing a set</option><option>Fit & application</option><option>Delivery & returns</option><option>My order</option></select><label for="HelpMessage">Your message</label><textarea id="HelpMessage" name="contact[body]" rows="5" required maxlength="3000"></textarea><p>Please leave out card details and other sensitive information.</p><button class="di-button" type="submit">Send message <span aria-hidden="true">↗</span></button>{% endif %}{% endform %}</section>
{% schema %}
{
  "name": "Contact",
  "settings": [
    {
      "type": "text",
      "id": "heading",
      "label": "Heading",
      "default": "Need a hand?"
    },
    {
      "type": "text",
      "id": "intro",
      "label": "Introduction",
      "default": "We\u2019re here to help. Tell us what you need."
    }
  ],
  "presets": [
    {
      "name": "Contact"
    }
  ]
}
{% endschema %}
