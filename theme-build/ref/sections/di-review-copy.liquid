{% if settings.di_review_mode %}<section class="di-wrap di-page di-review-editorial"><h1>{{ section.settings.heading | escape }}</h1>{% if section.settings.heading == 'Find your fit.' %}<img class="di-guide-page-image" src="https://cdn.shopify.com/s/files/1/0830/2339/7077/files/desi-nail-guide-v2.png?v=1791345943&amp;width=800" width="600" height="800" alt="A measuring tape across the widest part of a fingernail" loading="lazy">{% endif %}{% if template.suffix contains 'story-' %}<a class="di-back" href="/?view=desi-preview-journal">← {{ 'desi.story.all' | t }}</a><div data-story-gallery><div class="di-story-controls"><output aria-live="polite">1 / 4</output><button type="button" data-story-step="-1" aria-label="{{ 'desi.story.previous' | t }}">←</button><button type="button" data-story-step="1" aria-label="{{ 'desi.story.next' | t }}">→</button></div><div class="rte">{{ section.settings.body }}</div></div><h2 class="di-more-stories">{{ 'desi.story.more' | t }}</h2><nav class="di-related-stories">{% assign keys = 'on-me,green-flag,shaadi-shift' | split: ',' %}{% for key in keys %}{% unless template.suffix contains key %}{% assign c = shop.metaobjects.small_talk_campaign[key] %}<a href="/?view=desi-preview-story-{{ key }}"><strong>{{ c.name.value | escape }}</strong><span>{{ c.headline.value | escape }} ↗</span></a>{% endunless %}{% endfor %}</nav>{% else %}<div class="rte di-guide-copy">{{ section.settings.body }}</div>{% endif %}</section>{% endif %}
{% schema %}{"name":"Draft content preview","settings":[{"type":"text","id":"heading","label":"Heading"},{"type":"html","id":"body","label":"Saved native content snapshot"}]}{% endschema %}