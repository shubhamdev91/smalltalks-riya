{% liquid
 assign first_block = section.blocks.first
 assign c = first_block.settings.campaign
 assign next_block = section.blocks[1]
 assign next_c = next_block.settings.campaign
%}
{% if c != blank %}
<desi-hero class="di-hero" data-set="{{ c.system.handle }}" data-autoplay="{{ section.settings.autoplay }}" data-hand-base="{{ settings.di_hand_base | escape }}" style="--scene:{{ c.background.value }};--ink:{{ c.foreground.value }};--cta:{{ c.cta_background.value }};--cta-ink:{{ c.cta_foreground.value }};--set:{{ c.motion_index.value }};--tone:1;--diet-can:url('{{ 'desi-diet-can-v1.webp' | asset_url }}')">
 <div class="di-hero-copy"><p class="di-note" data-note>{{ c.note.value | escape }}</p><h1 data-headline>{{ c.headline.value | escape }}</h1></div>
 <div class="di-hero-character" aria-hidden="true" data-character></div>
 <div class="di-halo" aria-hidden="true"></div>
 <div class="di-finger" aria-hidden="true"></div>
 <button class="di-main-nail" data-main aria-label="Hold to pause the nail preview" type="button">{% render 'di-nail', index: c.motion_index.value, row: 0 %}</button>
 <div class="di-accent" data-accent>{% render 'di-nail', index: c.motion_index.value, row: 1 %}</div>
 <div class="di-third-sample">{% render 'di-nail', index: c.motion_index.value, row: 2 %}</div><div class="di-signature-sample" data-signature>{% render 'di-nail', index: c.motion_index.value, row: 0 %}</div><button class="di-next" data-next type="button" aria-label="Next set: {{ next_c.name.value | escape }}"><span class="di-preview-hand" style="--hand:{{ next_c.motion_index.value }}">{% capture next_sequence %}{% render 'di-nail-sequence', key: next_c.system.handle %}{% endcapture %}{% assign next_rows = next_sequence | strip | split: ',' %}{% assign donor_found = false %}{% for n in (0..4) %}{% assign nail_row = next_rows[n] | plus: 0 %}<span class="di-preview-nail di-preview-nail--{{ n }}"{% if nail_row == 0 and donor_found == false %} data-donor{% assign donor_found = true %}{% endif %}>{% render 'di-nail', index: next_c.motion_index.value, row: nail_row %}</span>{% endfor %}</span><span class="di-next-label">Next <span aria-hidden="true">↗</span></span></button>
 <div class="di-hero-controls"><button data-pause type="button" aria-label="Pause animation">Ⅱ</button><button data-tone type="button" aria-label="Skin tone 2 of 4. Change preview tone"><span></span></button></div>
 <a class="di-button di-hero-cta" data-cta href="{% render 'di-link', c: c %}">Shop “{{ c.name.value | escape }}” <span aria-hidden="true">↗</span></a>
 <p class="visually-hidden" data-status aria-live="polite"></p>
 <script type="application/json" data-campaigns>[
 {% for block in section.blocks %}{% assign item = block.settings.campaign %}{% capture target %}{% render 'di-link', c: item %}{% endcapture %}{"key":{{ item.system.handle | json }},"name":{{ item.name.value | json }},"headline":{{ item.headline.value | json }},"note":{{ item.note.value | json }},"index":{{ item.motion_index.value | json }},"background":{{ item.background.value | json }},"foreground":{{ item.foreground.value | json }},"ctaBackground":{{ item.cta_background.value | json }},"ctaForeground":{{ item.cta_foreground.value | json }},"url":{{ target | strip | json }},"nails":{{ item.nail_art.value | image_url: width: 1800 | json }},"preview":{{ item.preview_art.value | image_url: width: 1600 | json }},"character":{{ item.character_art.value | image_url: width: 2000 | json }}}{% unless forloop.last %},{% endunless %}{% endfor %}
 ]</script>
</desi-hero>{% endif %}
{% schema %}
{
  "name": "Hero",
  "settings": [
    {
      "type": "checkbox",
      "id": "autoplay",
      "label": "Play up to three sets automatically",
      "default": true
    }
  ],
  "presets": [
    {
      "name": "Hero"
    }
  ],
  "blocks": [
    {
      "type": "campaign",
      "name": "Campaign",
      "settings": [
        {
          "type": "metaobject",
          "id": "campaign",
          "label": "Campaign",
          "metaobject_type": "small_talk_campaign"
        }
      ]
    }
  ]
}
{% endschema %}
