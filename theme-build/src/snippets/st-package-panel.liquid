{% doc %}
  Packaging panel (boards 4/5 PDP pattern, reused on shop tiles and Our Story): the set's approved box sits inside a
  campaign-colour panel with three loose nails beside it. The panel carries the size, not the box. The box is the
  clean-edge transparent derivative from st-artwork (st-package-<key>.webp, ~360 px, and -13x.webp, ~470 px); it is
  never shown wider than 380 css px and the srcset offers only those two files. The drop shadow is CSS. Packaging
  content is locked (shown as-is).

  @param {metaobject} campaign - small_talk_campaign entry.
  @param {string} [alt] - Box alt text (shared product media alt); empty = decorative.
  @param {string} [sizes] - sizes for the box image.
  @param {string} [loading] - 'lazy' (default) or 'eager'.
  @param {string} [fetchpriority] - e.g. 'high' for the PDP.
  @param {string} [class] - Extra class on the panel.

  @example
  {% render 'st-package-panel', campaign: campaign, alt: product.featured_media.alt, sizes: '28vw' %}
{% enddoc %}
{%- liquid
  assign key = campaign.system.handle
  capture pack_raw
    render 'st-motion-map', key: key, field: 'package'
  endcapture
  assign pack = pack_raw | strip | split: ','
  capture ps
    render 'st-pack-src', key: key
  endcapture
  assign ps = ps | strip | split: '|'
  capture hd
    render 'st-motion-map', key: key, field: 'hd_pack'
  endcapture
  assign box_sizes = sizes | default: '(min-width: 750px) 14rem, 28vw'
  assign box_loading = loading | default: 'lazy'
-%}
{%- if pack.size == 4 -%}
  <div class="st-pack{% if hd contains 'true' %} st-pack--hd{% endif %} {{ class }}" style="--st-pack-bg: {{ campaign.background.value | default: '#EEE8F5' }};">
    <img
      class="st-pack__box"
      src="{{ ps[0] }}"
      srcset="{{ ps[1] }}"
      sizes="{{ box_sizes }}"
      width="{{ ps[2] }}"
      height="{{ ps[3] }}"
      alt="{{ alt | strip | escape }}"
      loading="{{ box_loading }}"
      decoding="async"
      {% if fetchpriority != blank %}fetchpriority="{{ fetchpriority }}"{% endif %}
    >
    <span class="st-pack__nails" aria-hidden="true">
      {% render 'st-nail', campaign: campaign, role: 'signature', class: 'st-pack__nail st-pack__nail--1' %}
      {% render 'st-nail', campaign: campaign, role: 'accent', class: 'st-pack__nail st-pack__nail--2' %}
      {% render 'st-nail', campaign: campaign, role: 'extra', class: 'st-pack__nail st-pack__nail--3' %}
    </span>
  </div>
{%- endif -%}

{% stylesheet %}
  .st-pack {
    position: relative;
    display: block;
    width: 100%;
    aspect-ratio: 4 / 5;
    overflow: hidden;
    border-radius: var(--st-radius-card);
    background: var(--st-pack-bg, var(--st-tint));
  }

  .st-pack__box {
    position: absolute;
    inset-block-start: 50%;
    inset-inline-start: 9%;
    width: min(60%, 380px);
    height: auto;
    translate: 0 -50%;
    filter: drop-shadow(0 0.5rem 0.9rem rgb(31 26 46 / 0.28));
  }

  /* HD packaging sets (st-motion-map hd_pack): the 960 px source lifts the 380 css px cap (owner, 10 Oct). */
  .st-pack--hd .st-pack__box {
    width: 60%;
  }

  .st-pack__nails {
    position: absolute;
    inset-block: 14% 14%;
    inset-inline-end: 6%;
    display: grid;
    align-content: space-evenly;
    justify-items: center;
    width: 20%;
  }

  .st-pack__nail {
    width: 78%;
    filter: drop-shadow(0 0.2rem 0.35rem rgb(31 26 46 / 0.22));
  }

  .st-pack__nail--1 {
    --rot: 18deg;
  }

  .st-pack__nail--2 {
    --rot: -14deg;
    translate: -18% 0;
  }

  .st-pack__nail--3 {
    --rot: 26deg;
  }

  .st-pack--pdp {
    aspect-ratio: 1 / 1.08;
  }

  /* Larger panel: keep the rotated nails clear of the panel edge. */
  .st-pack--pdp .st-pack__nails {
    inset-inline-end: 9%;
    width: 17%;
  }

  @media screen and (max-width: 749px) {
    .st-pack--pdp {
      border-radius: 0;
    }
  }
{% endstylesheet %}
