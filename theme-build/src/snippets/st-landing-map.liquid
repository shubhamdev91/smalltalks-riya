  {%- when 'collage' -%}<span class="st-tiles__nail" style="left:calc(30*var(--k));top:calc(13*var(--k));rotate:-50deg;--st-nails-src:url('{{ 'st-hd-nails-on-me.webp' | asset_url }}');--col:0"></span><span class="st-tiles__nail" style="left:calc(94*var(--k));top:calc(6*var(--k));rotate:-40deg;--st-nails-src:url('{{ 'st-hd-nails-diet-cherry.webp' | asset_url }}');--col:2"></span><span class="st-tiles__nail" style="left:calc(14*var(--k));top:calc(69*var(--k));rotate:-55deg;--st-nails-src:url('{{ 'st-hd-nails-on-me.webp' | asset_url }}');--col:2"></span><span class="st-tiles__nail" style="left:calc(91*var(--k));top:calc(83*var(--k));rotate:-35deg;--st-nails-src:url('{{ 'st-hd-nails-green-flag.webp' | asset_url }}');--col:1"></span><span class="st-tiles__nail" style="left:calc(99*var(--k));top:calc(102*var(--k));rotate:-35deg;--st-nails-src:url('{{ 'st-hd-nails-wild-card.webp' | asset_url }}');--col:1"></span><span class="st-tiles__nail" style="left:calc(133*var(--k));top:calc(67*var(--k));rotate:25deg;--st-nails-src:url('{{ 'st-hd-nails-wild-card.webp' | asset_url }}');--col:0"></span><span class="st-tiles__nail" style="left:calc(1*var(--k));top:calc(141*var(--k));rotate:35deg;--st-nails-src:url('{{ 'st-hd-nails-brainwave.webp' | asset_url }}');--col:0"></span><span class="st-tiles__nail" style="left:calc(69*var(--k));top:calc(126*var(--k));rotate:-25deg;--st-nails-src:url('{{ 'st-hd-nails-pinky-promise.webp' | asset_url }}');--col:0"></span><span class="st-tiles__nail" style="left:calc(53*var(--k));top:calc(169*var(--k));rotate:-35deg;--st-nails-src:url('{{ 'st-hd-nails-shaadi-shift.webp' | asset_url }}');--col:1"></span><span class="st-tiles__nail" style="left:calc(119*var(--k));top:calc(172*var(--k));rotate:-40deg;--st-nails-src:url('{{ 'st-hd-nails-on-me.webp' | asset_url }}');--col:2"></span>
