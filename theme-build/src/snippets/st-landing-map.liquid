    {%- endcase -%}
  {%- when 'note_ticks' -%}
    {%- case key -%}
      {%- when 'on-me' -%}<svg class="st-ch__note-ticks" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3,15 L8,3 M7,17 L18,8 M8,20 L19,19"/></svg>
      {%- when 'wild-card' -%}<svg class="st-ch__note-ticks" viewBox="0 0 20 20" aria-hidden="true" focusable="false"><path d="M3,15 L8,3 M7,17 L18,8 M8,20 L19,19"/></svg>
    {%- endcase -%}
  {%- when 'arc' -%}
    {%- case key -%}
      {%- when 'diet-cherry' -%}560,51.7,560,51.7,-3
      {%- when 'brainwave' -%}560,51.7,560,51.7,-3
      {%- when 'green-flag' -%}560,51.7,650,44.0,-4
      {%- when 'shaadi-shift' -%}560,51.7,560,51.7,-5
      {%- when 'on-me' -%}560,51.7,560,51.7,-6
      {%- when 'wild-card' -%}0,0.0,0,0.0,0
