{% doc %}
  Landing chapter data per campaign (board 3), generated by theme-build/tools/build_landing.py from lab/params.json and
  the art table there (do not hand-edit). Positions of the text live in assets/st-landing.css (generated block).
  - 'head': headline font size and line pitch in board px, then the line count (1 = keep on one line).
  - 'row': sprite columns for the five-nail row.
  - 'note_lines': 2 = break the note after its first sentence, 1 = one line.
  - 'art': the set's character / prop art (decorative), positioned in board px.
  - 'ticks': sparkle ticks, if the board draws them.
  - 'arc': per headline line 'radius,sagitta' (radius 0 = straight), then the block tilt in degrees.

  @param {string} key - Campaign handle.
  @param {string} field - 'head', 'row', 'note_lines', 'art', 'ticks' or 'collage' (the tiles' nail scatter; key unused).

  @example
  {% render 'st-landing-map', key: 'on-me', field: 'art' %}
{% enddoc %}
{%- case field -%}
  {%- when 'head' -%}
    {%- case key -%}
      {%- when 'diet-cherry' -%}65.95,0.9,2
      {%- when 'brainwave' -%}57.66,1.145,2
      {%- when 'green-flag' -%}46.98,0.9,2
      {%- when 'shaadi-shift' -%}62.31,0.9,2
      {%- when 'on-me' -%}73.93,0.95,1
      {%- when 'wild-card' -%}61.54,1,2
      {%- when 'pinky-promise' -%}57.77,1,2
    {%- endcase -%}
  {%- when 'row' -%}
    {%- case key -%}
      {%- when 'diet-cherry' -%}1,0,2,1,1
      {%- when 'brainwave' -%}1,2,0,1,0
      {%- when 'green-flag' -%}1,0,1,0,1
      {%- when 'shaadi-shift' -%}2,1,0,1,2
      {%- when 'on-me' -%}0,2,1,2,0
      {%- when 'wild-card' -%}1,2,1,0,1
      {%- when 'pinky-promise' -%}0,0,0,0,0
    {%- endcase -%}
  {%- when 'note_lines' -%}
    {%- case key -%}
      {%- when 'diet-cherry' -%}2
      {%- when 'brainwave' -%}2
      {%- when 'green-flag' -%}2
      {%- when 'shaadi-shift' -%}1
      {%- when 'on-me' -%}2
      {%- when 'wild-card' -%}1
      {%- when 'pinky-promise' -%}1
    {%- endcase -%}
  {%- when 'art' -%}
    {%- case key -%}
      {%- when 'diet-cherry' -%}{%- capture st_alt -%}{% render 'st-art-alt', key: 'diet-cherry', kind: 'chapter' %}{%- endcapture -%}<div class="st-land__art st-land__art--l st-land__art--dsz" style="--dw:480;--dl:-2;--db:0;left:calc(-2*var(--k));bottom:calc(-68*var(--k));width:calc(194.9*var(--k))"><img src="{{ 'st-hd-diet-cherry-woman.webp' | asset_url }}" width="557" height="909" alt="{{ st_alt | strip | escape }}" loading="lazy" decoding="async" fetchpriority="low"></div><div class="st-land__art st-land__art--r" style="--rx:-8.2;left:calc(277.3*var(--k));bottom:calc(-37*var(--k));width:calc(120.9*var(--k))"><img src="{{ 'st-hd-diet-cherry-can-hand.webp' | asset_url }}" width="363" height="646" alt="" loading="lazy" decoding="async" fetchpriority="low"></div><div class="st-land__art st-land__art--l st-land__art--wide st-land__art--v12r" style="--rw:470;--rr:-6;--rb:-40;left:calc(277.3*var(--k));bottom:calc(-37*var(--k));width:calc(120.9*var(--k))"><img src="{{ 'st-diet-can.webp' | asset_url }}" width="1189" height="1323" alt="" loading="lazy" decoding="async" fetchpriority="low"></div>
      {%- when 'brainwave' -%}{%- capture st_alt -%}{% render 'st-art-alt', key: 'brainwave', kind: 'chapter' %}{%- endcapture -%}<div class="st-land__art st-land__art--l st-land__art--dsz st-land__art--dtop" style="--dw:300;--dl:-2;--dt:-2;left:calc(-2*var(--k));top:calc(-2*var(--k) + var(--dy, 0px));width:calc(134.9*var(--k))"><img src="{{ 'st-hd-brainwave-woman.webp' | asset_url }}" width="299" height="637" alt="{{ st_alt | strip | escape }}" loading="lazy" decoding="async" fetchpriority="low"></div><div class="st-land__art st-land__art--f st-land__art--dsz" style="--dw:468;--dl:240;--db:-46;left:calc(45.3*var(--k));bottom:calc(-29*var(--k));width:calc(303.4*var(--k))"><img src="{{ 'st-hd-brainwave-sketchbook.webp' | asset_url }}" width="1110" height="810" alt="" loading="lazy" decoding="async" fetchpriority="low"></div>
      {%- when 'green-flag' -%}{%- capture st_alt -%}{% render 'st-art-alt', key: 'green-flag', kind: 'chapter' %}{%- endcapture -%}<div class="st-land__art st-land__art--l st-land__art--mob" style="left:calc(-7*var(--k));bottom:calc(-130*var(--k));width:calc(405*var(--k))"><img src="{{ 'st-hd-green-flag-woman.webp' | asset_url }}" width="810" height="1011" alt="{{ st_alt | strip | escape }}" loading="lazy" decoding="async" fetchpriority="low"></div><div class="st-land__art st-land__art--l st-land__art--mob" style="left:calc(-8*var(--k));bottom:calc(0*var(--k));width:calc(200.9*var(--k))"><img src="{{ 'st-hd-green-flag-phone.webp' | asset_url }}" width="558" height="479" alt="" loading="lazy" decoding="async" fetchpriority="low"></div><div class="st-land__art st-land__art--l st-land__art--mob" style="left:calc(103.5*var(--k));bottom:calc(-130*var(--k));width:calc(255.5*var(--k))"><img src="{{ 'st-hd-green-flag-hand.webp' | asset_url }}" width="511" height="696" alt="" loading="lazy" decoding="async" fetchpriority="low"></div><div class="st-land__art st-land__art--l st-land__art--desk st-land__art--mirror" style="left:calc(-4*var(--k));bottom:calc(0*var(--k));width:calc(400*var(--k))"><img src="{{ 'st-hd-green-flag-woman-hero-v2.webp' | asset_url }}" width="729" height="1020" alt="{{ st_alt | strip | escape }}" loading="lazy" decoding="async" fetchpriority="low"></div>
      {%- when 'shaadi-shift' -%}{%- capture st_alt_desk -%}{% render 'st-art-alt', key: 'shaadi-shift', kind: 'chapter-desk' %}{%- endcapture -%}{%- capture st_alt -%}{% render 'st-art-alt', key: 'shaadi-shift', kind: 'chapter' %}{%- endcapture -%}<div class="st-land__art st-land__art--l st-land__art--mob" style="left:calc(0*var(--k));bottom:calc(-4.4*var(--k));width:calc(398.2*var(--k))"><img src="{{ 'st-hd-shaadi-shift-sweep.webp' | asset_url }}" width="1048" height="672" alt="{{ st_alt | strip | escape }}" loading="lazy" decoding="async" fetchpriority="low"></div><div class="st-land__art st-land__art--l st-land__art--desk st-land__art--dsz" style="--dw:470;--dl:-6;--db:-60;left:calc(0*var(--k));bottom:calc(-4.4*var(--k));width:calc(398.2*var(--k))"><img src="{{ 'st-hd-shaadi-shift-woman.webp' | asset_url }}" width="780" height="1022" alt="{{ st_alt_desk | strip | escape }}" loading="lazy" decoding="async" fetchpriority="low"></div>
      {%- when 'on-me' -%}{%- capture st_alt -%}{% render 'st-art-alt', key: 'on-me', kind: 'chapter' %}{%- endcapture -%}<div class="st-land__art st-land__art--l st-land__art--dsz" style="--dw:500;--dl:-6;--db:-40;left:calc(-6*var(--k));bottom:calc(0*var(--k));width:calc(225.7*var(--k))"><img src="{{ 'st-hd-on-me-woman.webp' | asset_url }}" width="535" height="721" alt="{{ st_alt | strip | escape }}" loading="lazy" decoding="async" fetchpriority="low"></div><div class="st-land__art st-land__art--r" style="--rx:-8.4;left:calc(263.3*var(--k));bottom:calc(-5.7*var(--k));width:calc(135.1*var(--k))"><img src="{{ 'st-hd-on-me-receipt-hand.webp' | asset_url }}" width="391" height="581" alt="" loading="lazy" decoding="async" fetchpriority="low"></div><div class="st-land__art st-land__art--l st-land__art--wide st-land__art--v12r" style="--rw:330;--rr:-10;--rb:-8;left:calc(263.3*var(--k));bottom:calc(-5.7*var(--k));width:calc(135.1*var(--k))"><img src="{{ 'st-hd-on-me-receipt-hand.webp' | asset_url }}" width="391" height="581" alt="" loading="lazy" decoding="async" fetchpriority="low"></div>
      {%- when 'wild-card' -%}{%- capture st_alt -%}{% render 'st-art-alt', key: 'wild-card', kind: 'chapter' %}{%- endcapture -%}<div class="st-land__art st-land__art--l st-land__art--dsz" style="--dw:588;--dl:-8;--db:-176;left:calc(-8.2*var(--k));bottom:calc(-204*var(--k));width:calc(363.3*var(--k))"><img src="{{ 'st-hd-wild-card-woman-v2.webp' | asset_url }}" width="773" height="1022" alt="{{ st_alt | strip | escape }}" loading="lazy" decoding="async" fetchpriority="low"></div><div class="st-land__art st-land__art--f st-land__art--dsz" style="--dw:372;--dl:300;--db:-22;left:calc(174.4*var(--k));bottom:calc(-32.8*var(--k));width:calc(217.8*var(--k))"><img src="{{ 'st-hd-wild-card-cards-hand-v2.webp' | asset_url }}" width="484" height="556" alt="" loading="lazy" decoding="async" fetchpriority="low"></div><div class="st-land__cards" aria-hidden="true"><img class="st-land__card-ace" src="{{ 'st-hd-wild-card-ace.svg' | asset_url }}" width="46" height="64" alt="" loading="lazy" decoding="async"><img class="st-land__card-king" src="{{ 'st-hd-wild-card-king.svg' | asset_url }}" width="46" height="64" alt="" loading="lazy" decoding="async"></div>
