{% doc %}
  Renders all meta tags for the page including Open Graph, Twitter Cards, and SEO tags.

  @param {object} [product] - The product object, available on product pages for price meta tags.
{% enddoc %}

<meta charset="utf-8">
<meta
  http-equiv="X-UA-Compatible"
  content="IE=edge"
>
<meta
  name="viewport"
  content="width=device-width,initial-scale=1,viewport-fit=cover"
>
<meta
  name="theme-color"
  content=""
>

{%- liquid
  # Small Talk: theme-local title/meta where Shopify has no SEO field (copy register SEO-003/004 for the
  # automatic /collections/all, SEO-073 for 404). Every other page keeps its native SEO fields.
  assign st_title = page_title
  assign st_description = page_description
  if request.page_type == 'collection' and collection.handle == 'all'
    assign st_title = 'small_talk.seo.shop_title' | t
    assign st_description = 'small_talk.seo.shop_description' | t
  elsif request.page_type == '404'
    assign st_title = 'small_talk.seo.not_found_title' | t
  endif

  # the talks (seo/STRATEGY.md §10): thread and topic pages are metaobject pages. Title "{title} | the talks | Small
  # Talk" (TLK-092; the middle part is the blog's own title, TLK-001); a thread's description is its body (real text).
  # Old the-talks articles point their canonical at the thread they moved to (end state: unpublish + 301, SD29).
  assign st_canonical = canonical_url
  assign st_talks_name = blogs['the-talks'].title
  if metaobject and metaobject.system.type == 'talk_thread'
    if st_talks_name != blank and metaobject.title.value != blank
      assign st_title = metaobject.title.value | append: ' | ' | append: st_talks_name | append: ' | ' | append: shop.name
    endif
    if st_description == blank and metaobject.body.value != blank
      assign st_description = metaobject.body.value | newline_to_br | replace: '<br />', ' ' | strip_newlines | strip | truncate: 160
    endif
  elsif metaobject and metaobject.system.type == 'talk_topic'
    if st_talks_name != blank and metaobject.label.value != blank
      assign st_title = metaobject.label.value | append: ' | ' | append: st_talks_name | append: ' | ' | append: shop.name
    endif
  elsif request.page_type == 'page' and page.handle == 'the-talks' and blogs['the-talks'] != blank
    # the old talks page duplicates the hub (QA F7): noindex in st-seo, canonical to the hub (end state: unpublish + 301).
    assign st_canonical = request.origin | append: blogs['the-talks'].url
  elsif request.page_type == 'article' and blog.handle == 'the-talks'
    assign st_moved_handle = article.handle | split: '/' | last
    assign st_moved = metaobjects.talk_thread[st_moved_handle]
    if st_moved != blank
      assign st_canonical = request.origin | append: st_moved.system.url
    endif
  endif

  assign page_title = st_title
  assign page_description = st_description

  assign og_title = page_title | default: shop.name
  assign og_url = st_canonical | default: request.origin
  assign og_type = 'website'
  assign og_description = page_description | default: shop.description | default: shop.name

  if request.page_type == 'product'
    assign og_type = 'product'
  elsif request.page_type == 'article'
    assign og_type = 'article'
  elsif metaobject and metaobject.system.type == 'talk_thread'
    assign og_type = 'article'
  elsif request.page_type == 'password'
    assign og_url = request.origin
  endif
%}

<meta
  property="og:site_name"
  content="{{ shop.name }}"
>
<meta
  property="og:url"
  content="{{ og_url }}"
>
<meta
  property="og:title"
  content="{{ og_title | escape }}"
>
<meta
  property="og:type"
  content="{{ og_type }}"
>
<meta
  property="og:description"
  content="{{ og_description | escape }}"
>

{%- liquid
  # Share image fallback (owner, 10 Oct): st-artwork's 1200 × 630 logo card where the page has no image of its own
  # (home, pages, blog indexes). Switch: set st_og_default to the asset's filename when it lands.
  assign st_og_default = 'st-og-default.jpg'
-%}
{%- if page_image == blank and st_og_default != blank -%}
  <meta property="og:image" content="https:{{ st_og_default | asset_url }}">
  <meta property="og:image:secure_url" content="https:{{ st_og_default | asset_url }}">
  <meta property="og:image:width" content="1200">
  <meta property="og:image:height" content="630">
  {%- comment -%} SEO-110 (copy v1.4.5), only on the logo fallback. {%- endcomment -%}
  <meta property="og:image:alt" content="The Small Talk logo: “small talk” in bold royal-blue lowercase letters, stacked on two lines on a paper-white ground.">
  <meta name="twitter:image:alt" content="The Small Talk logo: “small talk” in bold royal-blue lowercase letters, stacked on two lines on a paper-white ground.">
{%- endif -%}
{%- if page_image -%}
  <meta
    property="og:image"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:secure_url"
    content="https:{{ page_image | image_url }}"
  >
  <meta
    property="og:image:width"
    content="{{ page_image.width }}"
  >
  <meta
    property="og:image:height"
    content="{{ page_image.height }}"
  >
{%- endif -%}

{%- if request.page_type == 'product' -%}
  <meta
    property="og:price:amount"
    content="{{ product.price | money_without_currency | strip_html }}"
  >
  <meta
    property="og:price:currency"
    content="{{ cart.currency.iso_code }}"
  >
{%- endif -%}

{%- if settings.social_twitter_link != blank -%}
  <meta
    name="twitter:site"
    content="{{ settings.social_twitter_link | split: 'twitter.com/' | last | prepend: '@' }}"
  >
{%- endif -%}
<meta
  name="twitter:card"
  content="summary_large_image"
>
<meta
  name="twitter:title"
  content="{{ og_title | escape }}"
>
<meta
  name="twitter:description"
  content="{{ og_description | escape }}"
>

<title>
  {{ page_title }}
  {%- if current_tags %} &ndash; tagged "{{ current_tags | join: ', ' }}"{% endif -%}
  {%- if current_page != 1 %} &ndash; Page {{ current_page }}{% endif -%}
  {%- unless page_title contains shop.name %} &ndash; {{ shop.name }}{% endunless -%}
</title>

<link
  rel="canonical"
  href="{{ st_canonical }}"
>

{% if page_description %}
  <meta
    name="description"
    content="{{ page_description | escape }}"
  >
{% endif %}
