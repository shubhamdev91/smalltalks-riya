{% doc %}
  One thread row on the talks hub / topic pages (talks.md "Thread row"): the whole row is one link (TLK-011). Set-nail
  avatar, alias + real date (TLK-008/009), title, excerpt and the real reply count (TLK-010). At 0 replies the line
  follows the posting switch (st-talk-live): "First reply's yours ›" while posting is open (TLK-010), "No replies yet"
  with no chevron while it is closed (TLK-156). st-talks.js builds the same markup for a shopper's own new talk, which
  only happens while posting is open (keep the two in step).

  @param {object} thread - A talk_thread metaobject.

  @example
  {% render 'st-talk-row', thread: thread %}
{% enddoc %}

{%- capture live_flag -%}{%- render 'st-talk-live' -%}{%- endcapture -%}
{%- liquid
  assign t_alias = thread.alias.value | default: 'small talk'
  assign replies = thread.reply_count.value | default: 0 | plus: 0
  assign row_label = 'small_talk.talks.hub.row_label' | t: title: '@@T@@', count: replies | replace: '@@T@@', thread.title.value
  assign excerpt = thread.body.value | newline_to_br | replace: '<br />', ' ' | strip_newlines | strip
-%}
<li class="st-trow" data-st-thread="{{ thread.system.handle | escape }}">
  <a class="st-trow__link" href="{{ thread.system.url }}" aria-label="{{ row_label | escape }}">
    {%- render 'st-talk-avatar', set: thread.avatar.value, alias: t_alias -%}
    <span class="st-trow__text">
      <span class="st-trow__meta">
        <span class="st-trow__author">{{ t_alias | escape }}</span>
        <span class="visually-hidden"> · </span>
        {%- if thread.posted_at.value != blank -%}
          {%- render 'st-talk-time', at: thread.posted_at.value -%}
        {%- endif -%}
      </span>
      <span class="st-trow__title">{{ thread.title.value | escape }}</span>
      {%- if excerpt != blank -%}
        <span class="st-trow__excerpt">{{ excerpt | truncate: 160 | escape }}</span>
      {%- endif -%}
      {%- if replies > 0 or live_flag == 'on' -%}
        <span class="st-trow__count">
          {%- if replies > 0 -%}
            {{- 'small_talk.talks.replies' | t: count: replies -}}
          {%- else -%}
            {{- 'small_talk.talks.hub.first_reply' | t -}}
          {%- endif -%}
          <svg viewBox="0 0 8 14" aria-hidden="true" focusable="false"><path d="M1.5 1.5 L6.5 7 L1.5 12.5"/></svg>
        </span>
      {%- else -%}
        <span class="st-trow__count">{{ 'small_talk.talks.live.no_replies_closed' | t }}</span>
      {%- endif -%}
    </span>
  </a>
</li>
