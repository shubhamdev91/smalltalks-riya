{% doc %}
  One quick answer (question + answer disclosure). If the row has a fact gate, it renders only once "Gate
  confirmed" is on; the theme editor shows a note instead.
{% enddoc %}

{%- liquid
  assign visible = true
  if block.settings.gate != blank and block.settings.confirmed == false
    assign visible = false
  endif
-%}

{%- if visible and block.settings.question != blank and block.settings.answer != blank -%}
  <details class="st-question__item" {{ block.shopify_attributes }}>
    <summary class="st-question__summary"><span>{{ block.settings.question | escape }}</span><span class="st-question__icon" aria-hidden="true"></span></summary>
    <div class="st-question__answer st-rte">{{ block.settings.answer }}</div>
  </details>
{%- elsif request.design_mode -%}
  <p class="st-question__held" {{ block.shopify_attributes }}>
    {{ block.settings.question | default: 'Question' | escape }}: hidden until {{ block.settings.gate | default: 'a question and answer are added' | escape }}{% if block.settings.gate != blank %} is confirmed{% endif %}.
  </p>
{%- endif -%}

{% stylesheet %}
  .st-question__item {
    border-block-end: 1px solid var(--st-divider);
  }

  .st-question__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: 3.25rem;
    padding-block: 0.6rem;
    color: var(--st-ink);
    font-weight: 500;
    cursor: pointer;
    list-style: none;
  }

  .st-question__summary::-webkit-details-marker {
    display: none;
  }

  .st-question__icon {
    position: relative;
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
  }

  .st-question__icon::before,
  .st-question__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    background: var(--st-blue);
    translate: 0 -50%;
  }

  .st-question__icon::after {
    rotate: 90deg;
  }

  .st-question__item[open] .st-question__icon::after {
    rotate: 0deg;
  }

  .st-question__answer {
    padding-block-end: 1rem;
  }

  .st-question__held {
    margin: 0;
    padding: 0.75rem 0;
    border-block-end: 1px dashed var(--st-divider);
    color: var(--st-muted);
    font-size: 0.875rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Small Talk question",
  "settings": [
    { "type": "text", "id": "question", "label": "Question" },
    { "type": "richtext", "id": "answer", "label": "Answer" },
    { "type": "text", "id": "gate", "label": "Gate", "info": "Register gate ID, if the row has one (e.g. G2)." },
    { "type": "checkbox", "id": "confirmed", "label": "Gate confirmed", "default": false }
  ],
  "presets": [{ "name": "Small Talk question" }]
}
{% endschema %}
