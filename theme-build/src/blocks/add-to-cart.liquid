

{%- doc -%}
  This block is used to display the add to cart button.
  Intended for product-form.liquid block.

  @param {string} can_add_to_cart - Whether the product can be added to the cart
  @param {string} add_to_cart_text - The text of the add to cart button
{%- enddoc -%}

{% liquid
  # Small Talk labels (copy register PDP-011…013, G5): "Add to bag · {price}" for a live, priced variant;
  # "Coming soon" (disabled) while the price is 0 or the variant can't be bought for any reason other than stock;
  # "Sold out" (disabled) comes from buy-buttons.
  assign st_variant = closest.product.selected_or_first_available_variant
  assign st_sold_out_text = 'products.product.sold_out' | t
  if st_variant != blank
    if st_variant.price == 0
      assign can_add_to_cart = false
      assign add_to_cart_text = 'small_talk.product.coming_soon' | t
    elsif can_add_to_cart
      # PDP-011 "Add to bag · {price}", split from the locale string itself: the price part can be hidden visually
      # on narrow phones (still part of the accessible name), so no new copy is needed.
      assign st_price = st_variant.price | money_without_trailing_zeros
      assign st_full = 'small_talk.product.add_to_bag' | t: price: '@@ST_PRICE@@'
      assign st_parts = st_full | split: '@@ST_PRICE@@'
      assign st_short = st_parts[0] | rstrip | remove_last: '·' | rstrip
      assign st_rest = st_parts[0] | remove_first: st_short
      capture add_to_cart_text
        echo '<span class="st-atb">' | append: st_short | append: '</span><span class="st-atb__more">' | append: st_rest | append: st_price | append: st_parts[1] | append: '</span>'
      endcapture
    elsif add_to_cart_text != st_sold_out_text
      assign add_to_cart_text = 'small_talk.product.coming_soon' | t
    endif
  endif

  assign scoped_class = block.settings.style_class | append: '--' | append: block.id
  assign class = 'add-to-cart-button ' | append: block.settings.style_class | append: ' ' | append: scoped_class
  assign id = 'BuyButtons-ProductSubmitButton-' | append: block.id
%}
{% render 'button-custom-styles', block_settings: block.settings, block_id: block.id %}
{% render 'add-to-cart-button-styles' %}
{% render 'fly-to-cart-styles' %}

<span
  {{ block.shopify_attributes }}
  style="--add-to-cart-font-case: {{ settings.button_text_case }};"
>
  {% render 'add-to-cart-button',
    id: id,
    class: class,
    can_add_to_cart: can_add_to_cart,
    show_icon: can_add_to_cart,
    product: closest.product,
    add_to_cart_text: add_to_cart_text,
    data_testid: 'standalone-add-to-cart'
  %}
</span>

{% schema %}
{
  "name": "t:names.add_to_cart",
  "tag": null,
  "settings": [
    {
      "type": "select",
      "id": "style_class",
      "label": "t:settings.style",
      "options": [
        {
          "value": "button",
          "label": "t:options.primary"
        },
        {
          "value": "button-secondary",
          "label": "t:options.secondary"
        },
        {
          "value": "button-custom",
          "label": "t:options.custom"
        }
      ],
      "default": "button-secondary",
      "info": "t:info.edit_button_style_in_theme_settings"
    },
    {
      "type": "header",
      "content": "t:content.button_colors",
      "visible_if": "{{ block.settings.style_class == \"button-custom\" }}"
    },
    {
      "type": "color",
      "id": "custom_button_background",
      "label": "t:settings.background",
      "default": "{{ settings.color_palette.foreground }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_text",
      "label": "t:settings.text",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    },
    {
      "type": "color",
      "id": "custom_button_border",
      "label": "t:settings.borders",
      "default": "{{ settings.color_palette.background }}",
      "alpha": true,
      "visible_if": "{{ block.settings.style_class == 'button-custom' }}"
    }
  ]
}
{% endschema %}
