{% doc %}
  The approved campaign packaging for Our Story, as stacked packaging panels (st-package-panel: the box on the set's
  colour with loose nails; never redrawn or upscaled). Each box carries its own set's alt (SEO-053: SEO-033…039
  wording), with no combined alt.
{% enddoc %}

{%- assign campaigns = block.settings.campaigns.values | default: block.settings.campaigns -%}

<div class="st-packaging" {{ block.shopify_attributes }}>
  {%- for c in campaigns limit: 7 -%}
    <div class="st-packaging__item">
      {%- capture box_alt -%}{% render 'st-art-alt', key: c.system.handle, kind: 'package' %}{%- endcapture -%}
      {% render 'st-package-panel', campaign: c, alt: box_alt, sizes: '9rem' %}
    </div>
  {%- endfor -%}
</div>

{% stylesheet %}
  /* Board 4: the boxes stack and overlap a little on phones, sit side by side from tablet up. Never wider than
     the ~360 px source. */
  .st-packaging {
    display: grid;
    justify-items: center;
  }

  .st-packaging__item {
    width: min(100%, 15rem);
    margin: 0;
  }

  .st-packaging__item:nth-child(odd) {
    margin-inline-end: 2.5rem;
  }

  .st-packaging__item:nth-child(even) {
    margin-inline-start: 2.5rem;
  }

  .st-packaging__item + .st-packaging__item {
    margin-block-start: -2.5rem;
  }

  @media (min-width: 750px) {
    .st-packaging {
      grid-template-columns: repeat(auto-fit, minmax(10rem, 1fr));
      gap: 1rem;
    }

    .st-packaging__item,
    .st-packaging__item:nth-child(n) {
      width: min(100%, 15rem);
      margin: 0;
    }
  }

  .st-packaging__item .st-pack {
    box-shadow: 0 0.5rem 1.25rem rgb(31 26 46 / 0.18);
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Small Talk packaging",
  "settings": [
    {
      "type": "metaobject_list",
      "id": "campaigns",
      "label": "Campaigns",
      "metaobject_type": "small_talk_campaign",
      "limit": 7
    }
  ],
  "presets": [
    {
      "name": "Small Talk packaging"
    }
  ]
}
{% endschema %}
