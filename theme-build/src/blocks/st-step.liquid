{% doc %}
  One Nail Guide step (board 5): number, heading, body, optional illustration and an optional expander (for
  example the kit's own steps). Every step's copy is fact-gated (G2–G4), so place each step inside an st-gate
  group. Renders nothing without a heading.
{% enddoc %}

{%- if block.settings.heading != blank -%}
  <section class="st-step" aria-labelledby="StStep-{{ block.id }}" {{ block.shopify_attributes }}>
    <h2 class="st-step__heading" id="StStep-{{ block.id }}">
      {%- if block.settings.number != blank -%}<span class="st-step__number">{{ block.settings.number | escape }}</span> {% endif -%}
      {{- block.settings.heading | escape -}}
    </h2>
    {%- if block.settings.text != blank -%}
      <div class="st-step__text st-rte">{{ block.settings.text }}</div>
    {%- endif -%}
    {%- if block.settings.image != blank -%}
      {{ block.settings.image | image_url: width: 1000 | image_tag: alt: block.settings.image_alt, loading: 'lazy', sizes: '(min-width: 750px) 40rem, 92vw', widths: '400, 700, 1000', class: 'st-step__image' }}
    {%- endif -%}
    {%- if block.settings.expander_label != blank and block.settings.expander != blank -%}
      <details class="st-step__more">
        <summary class="st-step__summary"><span>{{ block.settings.expander_label | escape }}</span><span class="st-step__icon" aria-hidden="true"></span></summary>
        <div class="st-step__more-body st-rte">{{ block.settings.expander }}</div>
      </details>
    {%- endif -%}
  </section>
{%- endif -%}

{% stylesheet %}
  .st-step {
    display: grid;
    gap: 0.75rem;
  }

  .st-step__heading {
    margin: 0;
    color: var(--st-ink);
    font-family: var(--st-font-button);
    font-weight: 600;
    font-size: 1.375rem;
    line-height: 1.2;
  }

  .st-step__number {
    margin-inline-end: 0.5rem;
    color: var(--st-plum);
    font-variant-numeric: tabular-nums;
  }

  .st-step__image {
    width: 100%;
    height: auto;
    border-radius: var(--st-radius-card);
  }

  .st-step__more {
    border: 1px solid var(--st-divider);
    border-radius: 0.75rem;
  }

  .st-step__summary {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
    min-height: var(--minimum-touch-target);
    padding: 0.6rem 1rem;
    color: var(--st-ink);
    font-weight: 600;
    cursor: pointer;
    list-style: none;
  }

  .st-step__summary::-webkit-details-marker {
    display: none;
  }

  .st-step__icon {
    position: relative;
    flex: none;
    width: 0.9rem;
    height: 0.9rem;
  }

  .st-step__icon::before,
  .st-step__icon::after {
    content: '';
    position: absolute;
    inset: 50% 0 auto;
    height: 1.5px;
    background: var(--st-blue);
    translate: 0 -50%;
  }

  .st-step__icon::after {
    rotate: 90deg;
  }

  .st-step__more[open] .st-step__icon::after {
    rotate: 0deg;
  }

  .st-step__more-body {
    padding: 0 1rem 1rem;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Small Talk guide step",
  "settings": [
    { "type": "text", "id": "number", "label": "Number", "placeholder": "01" },
    { "type": "text", "id": "heading", "label": "Heading" },
    { "type": "richtext", "id": "text", "label": "Body" },
    { "type": "image_picker", "id": "image", "label": "Illustration" },
    { "type": "text", "id": "image_alt", "label": "Illustration alt text" },
    { "type": "text", "id": "expander_label", "label": "Expander label" },
    { "type": "richtext", "id": "expander", "label": "Expander content" }
  ],
  "presets": [{ "name": "Small Talk guide step" }]
}
{% endschema %}
