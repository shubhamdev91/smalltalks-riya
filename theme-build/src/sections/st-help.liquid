{% comment %}
  Section contract.
  Help page, board 4 frame 6 (spec/help.md). "Need a hand?" (PG-033) and "We're here to help." (PG-034), a real
  search box (PG-035) that sends the visitor to the store search, then the theme blocks: "Browse help topics"
  (st-help-topics with st-help-topic rows, PG-036…047, PG-105…109) and "Still need help?" (st-help-form, PG-048…060).
  Topic rows open in place; /pages/help#delivery (and #returns, #fit, #orders) opens that topic.
  @example
  <!-- templates/page.desi-help.json -->
{% endcomment %}

{%- assign search_id = 'StHelpSearch-' | append: section.id -%}

<section class="st-help" aria-labelledby="StHelp-{{ section.id }}">
  <header class="st-help__header">
    <h1 class="st-help__title" id="StHelp-{{ section.id }}">{{ section.settings.heading | default: page.title | escape }}</h1>
    {%- if section.settings.sub != blank -%}
      <p class="st-help__sub">{{ section.settings.sub | escape }}</p>
    {%- endif -%}
  </header>

  {%- if section.settings.search_placeholder != blank -%}
    <form class="st-help__search" action="{{ routes.search_url }}" method="get" role="search">
      <label class="visually-hidden" for="{{ search_id }}">{{ section.settings.search_placeholder | escape }}</label>
      <svg class="st-help__search-icon" viewBox="0 0 24 24" aria-hidden="true" focusable="false"><circle cx="10.5" cy="10.5" r="7"/><path d="M15.6 15.6 L21 21"/></svg>
      <input
        id="{{ search_id }}"
        class="st-help__search-input"
        type="search"
        name="q"
        placeholder="{{ section.settings.search_placeholder | escape }}"
        autocomplete="off"
        enterkeyhint="search"
      >
      <input type="hidden" name="options[prefix]" value="last">
    </form>
  {%- endif -%}

  <div class="st-help__blocks">
    {% content_for 'blocks' %}
  </div>
</section>

{% stylesheet %}
  /* Board 4 frame 6 at 390 (spec/help.md). */
  .st-help {
    max-width: 40rem;
    margin-inline: auto;
    padding: 57px 25px 46px; /* H1 ink top at y 135 under the 69 px header */
    color: #111;
    font-family: var(--font-ui);
  }

  .st-help > * {
    min-width: 0;
  }

  .st-help__header {
    display: grid;
    justify-items: center;
    text-align: center;
  }

  /* H1 x 25–370, y 130–195 (ink 341 × 52 at x 28): spec says Source Serif 4 Bold 56 px; the board ink is the Black cut
     at ~70 px, −0.055em. Black (#0b0b0b) on this board. */
  .st-help__title {
    margin: 0 -20px;
    color: #0b0b0b;
    font-family: var(--font-shop-display);
    font-weight: 900;
    font-size: min(70px, 17.9vw);
    line-height: 1;
    letter-spacing: -0.055em;
  }

  /* Sub centred, y 205–228: DM Sans 700, #111; spec says 19 px, the board ink (189 px wide) is 21 px. */
  .st-help__sub {
    margin: 6px 0 0;
    color: #111;
    font-weight: 700;
    font-size: 21px;
    line-height: 1.3;
  }

  /* Search x 25–365, y 270–325: white, 1 px #e6e6ea, radius 8, glass 2 px at x 45, placeholder 15 px. */
  .st-help__search {
    position: relative;
    margin-block-start: 41px;
  }

  .st-help__search-icon {
    position: absolute;
    inset-inline-start: 18px;
    inset-block-start: 50%;
    inline-size: 24px;
    block-size: 24px;
    translate: 0 -50%;
    fill: none;
    stroke: #1a1a2e;
    stroke-width: 2;
    stroke-linecap: round;
    pointer-events: none;
  }

  .st-help__search-input {
    display: block;
    inline-size: 100%;
    min-block-size: 55px;
    padding: 0 16px 0 62px;
    border: 1px solid #e6e6ea;
    border-radius: 8px;
    background: #fff;
    color: #1a1a2e;
    font: inherit;
    font-size: 16px;
    box-shadow: 0 2px 10px rgb(26 26 46 / 0.05);
    appearance: none;
  }

  .st-help__search-input::placeholder {
    color: var(--st-placeholder);
    font-size: 15px;
    opacity: 1;
  }

  .st-help__search-input:focus-visible {
    outline: 2px solid var(--st-burgundy);
    outline-offset: 2px;
  }

  .st-help__blocks {
    display: grid;
  }

  /* BEGIN store desktop (st-fable, qa/desktop/STORE-DESKTOP-SPEC.md v1 section 2) */
  /* >= 1024: header block (H1, sub, search) centred at 720; then topics 7fr | the contact form 5fr, sticky under the
     header (it stops at the end of the two columns). */
  @media screen and (min-width: 1024px) {
    .st-help {
      max-width: none;
      width: min(1240px, 100% - 2 * clamp(32px, 4vw, 64px));
      padding: 56px 0 72px;
    }

    .st-help__header,
    .st-help__search {
      width: 100%;
      max-width: 720px;
      margin-inline: auto;
    }

    .st-help__title {
      margin: 0;
      font-size: 80px;
    }

    .st-help__sub {
      font-size: 22px;
    }

    .st-help__blocks {
      grid-template-columns: minmax(0, 7fr) minmax(0, 5fr);
      column-gap: clamp(32px, 4vw, 72px);
      align-items: start;
    }

    .st-help__blocks > * {
      grid-column: 1;
    }

    /* blocks render inside .shopify-block wrappers */
    .st-help__blocks > :has(> .st-help-form, > .st-help-form__placeholder) {
      grid-column: 2;
      grid-row: 1 / span 4;
      position: sticky;
      top: calc(var(--st-header-h, 76px) + 24px);
    }

    .st-help__blocks .st-help-form {
      margin-block-start: 52px;
    }
  }
  /* END store desktop */

  /* BEGIN wide frame (Tier A, >= 1680: the page frame grows to min(1440px, 100% - 2 gutters), the Journal §F rule; grids widen, text keeps its measure) */
  @media screen and (min-width: 1680px) {
    .st-help {
      width: min(1440px, 100% - 2 * clamp(32px, 4vw, 64px));
    }

    .st-help__blocks {
      align-items: stretch;
    }

    .st-help__blocks > :has(> .st-topics) {
      grid-row: 1 / span 4;
      display: flex;
      flex-direction: column;
    }

    .st-help__blocks .st-topics {
      display: flex;
      flex: 1 0 auto;
      flex-direction: column;
    }

    .st-help__blocks .st-topics__list {
      display: grid;
      flex: 1 0 auto;
      align-content: space-between;
    }
  }
  /* END wide frame */
{% endstylesheet %}

{% schema %}
{
  "name": "Small Talk help",
  "tag": "div",
  "class": "st-help-section",
  "settings": [
    { "type": "text", "id": "heading", "label": "Heading (PG-033)", "default": "Need a hand?" },
    { "type": "text", "id": "sub", "label": "Sub (PG-034)", "default": "We’re here to help." },
    { "type": "text", "id": "search_placeholder", "label": "Search placeholder (PG-035)", "default": "Search for a topic or keyword…" }
  ],
  "blocks": [{ "type": "st-help-topics" }, { "type": "st-help-form" }]
}
{% endschema %}
