              if (!clear) continue;
              const A = P[i];
              const B = P[j];
              const seg = [];
              const m = Math.max(1, Math.round(Math.hypot(B[0] - A[0], B[1] - A[1]) / STEP));
              for (let k = 1; k < m; k++) seg.push([A[0] + ((B[0] - A[0]) * k) / m, A[1] + ((B[1] - A[1]) * k) / m]);
