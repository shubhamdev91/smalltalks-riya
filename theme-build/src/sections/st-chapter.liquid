        Sm[0] = a0;
        if (pass === 0) Sm = meander(Sm, 7, 480, 1.1, 0);
        const lap2 = lap(Sm);
        P = Sm;
        for (let it = 0; it < 160; it++) {
          const Q = P.map((p) => p.slice());
          for (let i = 1; i < P.length - 1; i++) {
            const lx = (P[i - 1][0] + P[i + 1][0]) / 2 - P[i][0];
            const ly = (P[i - 1][1] + P[i + 1][1]) / 2 - P[i][1];
            Q[i] = repel(P[i][0] + 0.5 * (lx - 0.6 * lap2[i][0]), P[i][1] + 0.5 * (ly - 0.6 * lap2[i][1]), 10, 3, 0.35, 0.3);
          }
          P = Q;
        }
      }
      cutSpurs();
      P = gauss(P, 16, STEP);
      P[0] = a0;
      // ---- 5c. settle on a fine meander (6 / 360) with strong repulsion, so no stretch reads ruler-straight ----
      P = meander(P, 6, 360, 0.4, 80);
      const lapF = lap(P);
      for (let it = 0; it < 120; it++) {
        const Q = P.map((p) => p.slice());
        for (let i = 1; i < P.length - 1; i++) {
          const lx = (P[i - 1][0] + P[i + 1][0]) / 2 - P[i][0];
          const ly = (P[i - 1][1] + P[i + 1][1]) / 2 - P[i][1];
          Q[i] = repel(P[i][0] + 0.5 * (lx - lapF[i][0]), P[i][1] + 0.5 * (ly - lapF[i][1]), 8, 8, 0.6, 0.5);
