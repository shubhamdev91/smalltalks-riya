    const layout = () => {
      if (desk.matches) {
        if (!document.querySelector('.st-land__beeline[data-vb0]')) {
          document.querySelectorAll('.st-land__beeline').forEach((svg) => {
            svg.dataset.vb0 = svg.getAttribute('viewBox') || '';
