      const d = splineD(resample(P, 32));
      secs.forEach((sec) => {
        const r = sec.getBoundingClientRect();
        let svg = sec.querySelector(':scope > svg.st-beecur');
        if (!svg) {
          svg = document.createElementNS(NS, 'svg');
          svg.setAttribute('class', `st-beecur${sec.classList.contains('st-land--cream') ? ' st-beecur--cream' : ''}`);
          svg.setAttribute('aria-hidden', 'true');
          svg.setAttribute('focusable', 'false');
          svg.appendChild(document.createElementNS(NS, 'path'));
          sec.prepend(svg);
