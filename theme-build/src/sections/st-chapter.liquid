        svg.setAttribute('viewBox', `0 ${f(r.top - top0)} ${f(W)} ${f(r.height)}`);
        svg.firstChild.setAttribute('d', d);
      });
    };
    // the art's alpha is read from the images themselves, so the lazy ones are fetched first (laptop only)
    const ART_IMGS = '.st-land .st-land__art img, .st-land .st-land__card img';
    const artReady = () => {
      const wait = [];
      document.querySelectorAll(ART_IMGS).forEach((img) => {
        if (img.complete || !vis(img.closest('.st-land__art') || img)) return;
        img.loading = 'eager';
        wait.push(
          new Promise((r) => {
            img.addEventListener('load', r, { once: true });
            img.addEventListener('error', r, { once: true });
