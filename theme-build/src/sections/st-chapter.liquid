        P = Q;
      }
      // ---- 5a. spurs: where the line returns within 36 px of itself after 100+ px of arc (or within 90 px after
      // 300+ px) and the shortcut is clear, take the shortcut ----
      const cutSpurs = () => {
        for (let i = 1; i < P.length - 14; i++) {
          for (let j = Math.min(P.length - 2, i + 160); j >= i + 13; j--) {
