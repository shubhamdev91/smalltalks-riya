{% comment %}
  Section contract.
  One campaign chapter on the landing page, board 3 pattern (spec/landing.md): handwritten note, Hinglish headline set
  on an arc (real text in the h2, the arc letters aria-hidden), five-nail row, set name, "Shop the set ↗" pill, and the
  set's character / prop art bleeding off the edges. The section clips its own curved top edge and draws its segment of
  the dashed beeline (snippets/st-landing-join, from spec/joins.json); per-set geometry is in snippets/st-landing-map and
  assets/st-landing.css, both generated by theme-build/tools/build_landing.py.
  @example
  <!-- templates/index.json: one st-chapter per campaign, in board order. -->
{% endcomment %}

{%- liquid
  assign c = section.settings.campaign
-%}

{%- if c != blank -%}
  {%- liquid
    assign key = c.system.handle
    assign jkey = 'chapter-' | append: key
    capture chapter_url
      render 'st-campaign-url', campaign: c
    endcapture
    capture sprite_file
      render 'st-motion-map', key: key, field: 'sprite'
    endcapture
    assign sprite = sprite_file | strip | asset_url
    capture row_raw
      render 'st-landing-map', key: key, field: 'row'
    endcapture
    assign row = row_raw | strip | split: ','
    capture head_raw
      render 'st-landing-map', key: key, field: 'head'
    endcapture
    assign head = head_raw | strip | split: ','
    assign fs = head[0] | default: 64 | times: 1.0
    assign lead = head[1] | default: 1 | times: 1.0
    assign max_lines = head[2] | default: 2 | plus: 0
    capture note_lines_raw
      render 'st-landing-map', key: key, field: 'note_lines'
    endcapture
    capture note_ticks
      render 'st-landing-map', key: key, field: 'note_ticks'
    endcapture
    capture arc_raw
      render 'st-landing-map', key: key, field: 'arc'
    endcapture
    assign arc = arc_raw | strip | split: ','
    assign tilt = arc[4] | default: -3
    assign note_lines = note_lines_raw | strip | default: '1'
    assign set_name = c.name.value
    assign headline = c.headline.value | strip
    assign chapter_live = false
    if c.product.value != blank and c.product.value.price > 0 and c.product.value.available
      assign chapter_live = true
    endif

    # Headline lines: two sentences break between them; otherwise the most balanced word split (ties: shorter first line).
    assign lines = headline | split: '|||'
    if max_lines > 1
      assign sentences = headline | replace: '. ', '.|||' | split: '|||'
      assign words = headline | split: ' '
      if sentences.size == 2
        assign lines = sentences
      elsif words.size > 1
        assign best = 99999
        assign last = words.size | minus: 1
        for i in (1..last)
          assign part_a = words | slice: 0, i | join: ' '
          assign part_b = words | slice: i, 99 | join: ' '
          assign longer = part_a.size
          if part_b.size > longer
            assign longer = part_b.size
          endif
          assign score = longer | times: 100 | plus: part_a.size
          if score < best
            assign best = score
            assign split_at = i
          endif
        endfor
        assign part_a = words | slice: 0, split_at | join: ' '
        assign part_b = words | slice: split_at, 99 | join: ' '
        assign lines = part_a | append: '|||' | append: part_b | split: '|||'
      endif
    endif

    # Arc per line from the map (board-measured: R 560, 650 for wide lines, 0 = straight); chord 470 (x -40..430), so a
    # line's ends sit `sagitta` px below its apex.
    assign apex0 = fs | times: 0.8
    assign pitch = fs | times: lead
    assign line_count = lines.size | minus: 1
    assign tail = fs | times: 0.45
    assign vh = pitch | times: line_count | plus: apex0 | plus: tail | round
    assign mid = vh | divided_by: 2.0 | round

    # The set name's highlighter swipe (spec/name-highlight.md; approved by st-fable, 10 Oct). The swipe and the set's
    # deep ink switch on together (the ink alone fails on the dark grounds).
    assign name_highlight = true

    # Note: break after the first sentence when the board sets it on two lines.
    assign note = section.settings.caption | strip | escape
    if note_lines == '2'
      assign note = note | replace_first: '. ', '.<br>' | replace_first: '? ', '?<br>'
    endif
  -%}

  <section
    class="st-land st-ch{% if name_highlight %} st-ch--name-hl{% endif %}"
    data-land="{{ key }}"
    style="{% render 'st-landing-join', key: jkey, part: 'style' %}"
    aria-labelledby="StCh-{{ section.id }}"
  >
    <div class="st-land__inner">
      {% render 'st-landing-join', key: jkey, part: 'beeline' %}
      {% render 'st-landing-map', key: key, field: 'art' %}
      {% render 'st-landing-map', key: key, field: 'ticks' %}

      {%- if note != blank -%}
        <p class="st-ch__note{% if note_lines != '2' %} st-ch__note--one{% endif %}">{{ note }}{{ note_ticks | strip }}</p>
      {%- endif -%}

      <h2 class="st-ch__headline" id="StCh-{{ section.id }}">
        <span class="visually-hidden">{{ headline | escape }}</span>
        <svg viewBox="0 0 390 {{ vh }}" aria-hidden="true" focusable="false">
          <defs>
            {%- for line in lines -%}
              {%- liquid
                assign r_i = forloop.index0 | times: 2
                assign s_i = r_i | plus: 1
                assign radius = arc[r_i] | default: 560 | plus: 0
                assign sag = arc[s_i] | default: 51.7 | times: 1.0
                assign y_apex = forloop.index0 | times: pitch | plus: apex0
                assign y = y_apex | plus: sag | round: 1
              -%}
              {%- if radius > 0 -%}
                <path id="StArc-{{ section.id }}-{{ forloop.index0 }}" d="M-40,{{ y }} A{{ radius }},{{ radius }} 0 0 1 430,{{ y }}"/>
              {%- else -%}
                <path id="StArc-{{ section.id }}-{{ forloop.index0 }}" d="M-40,{{ y_apex | round: 1 }} L430,{{ y_apex | round: 1 }}"/>
              {%- endif -%}
            {%- endfor -%}
          </defs>
          <g transform="rotate({{ tilt }} 195 {{ mid }})">
            {%- for line in lines -%}
              <text class="st-arc" font-size="{{ fs | round: 1 }}"><textPath href="#StArc-{{ section.id }}-{{ forloop.index0 }}" startOffset="50%" text-anchor="middle">{{ line | strip | escape }}</textPath></text>
            {%- endfor -%}
          </g>
        </svg>
      </h2>

      <div class="st-ch__nails" aria-hidden="true">
        {%- for col in row -%}
          <span class="st-ch__nail" style="--st-nails: url('{{ sprite }}'); --col: {{ col }};"></span>
        {%- endfor -%}
      </div>

      {%- comment -%}
        The set name is the chapter's focal point (owner, 10 Oct; st-copy v1.4.7): curly quotes in aria-hidden spans,
        so the name reads "Diet Cherry"; the pill's label names the set without them. The <p> is the highlighter's box.
      {%- endcomment -%}
      <p class="st-ch__name"><span aria-hidden="true">“</span>{{ set_name | escape }}<span aria-hidden="true">”</span></p>

      {%- comment -%} LND-023 is gated on G5: the pill renders only while the set's product is live. {%- endcomment -%}
      {%- if chapter_live and section.settings.cta_label != blank -%}
        <a class="st-ch__pill" href="{{ chapter_url | strip }}" aria-label="{{ 'small_talk.chapter.shop_set_name' | t: name: set_name }}">
          {{- section.settings.cta_label | escape -}}
          <span class="st-arrow" aria-hidden="true">↗</span>
        </a>
      {%- endif -%}

      {%- if section.settings.caption_2 != blank -%}
        <p class="st-ch__caption">{{ section.settings.caption_2 | escape }}</p>
      {%- endif -%}
    </div>
  </section>
{%- elsif request.design_mode -%}
  <div class="st-chapter--empty"><p>Choose a campaign for this chapter.</p></div>
{%- endif -%}

{% stylesheet %}
  .st-chapter--empty {
    display: grid;
    place-items: center;
    min-height: 12rem;
    background: var(--st-cream);
  }
{% endstylesheet %}

{% javascript %}
  // One screen per chapter (owner, 10 Oct): a chapter's height follows the screen (assets/st-landing.css), so its
  // beeline is assembled for the live height from the parts in its data attributes (snippets/st-landing-join): the
  // top part (follows the text stack, moved by the desktop centring offset), a vertical run, and the bottom part
  // (follows the bottom-anchored art, y relative to the bottom).
  // Owner v12.1 (qa/desktop/owner-v12/README.md): on phones every landing route is then pulled in from the screen edges
  // (x -> 20 + x * 350 / 390) and its long straight runs rounded into smooth half-waves (rebuild), and the dash phase is
  // carried down the page, so the dashes run on across the joins. Without JS the generated (already softened) phone
  // path stays. From 1024 (v12.1c / v12.1d) the landing gets one flowing line computed from the live layout (laptop).
  (() => {
    const DASH = 14.5;
    const NS = 'http://www.w3.org/2000/svg';
    const NUM = /-?\d+(?:\.\d+)?/g;
    const shift = (d, dy) => d.replace(/(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/g, (m, x, y) => `${x},${+(+y + dy).toFixed(1)}`);
    const f = (v) => +v.toFixed(1);
    const parse = (d) => {
      const segs = [];
      let cur = null;
      const re = /([MLC])([^MLC]*)/g;
      let m;
      while ((m = re.exec(d))) {
        const n = (m[2].match(NUM) || []).map(Number);
        if (m[1] === 'M') {
          cur = [n[0], n[1]];
          segs.push({ t: 'M', p: cur });
        } else if (m[1] === 'L') {
          for (let i = 0; i + 1 < n.length; i += 2) {
            const p = [n[i], n[i + 1]];
            segs.push({ t: 'L', a: cur, p });
            cur = p;
          }
        } else {
          for (let i = 0; i + 5 < n.length; i += 6) {
            const c1 = [n[i], n[i + 1]];
            const c2 = [n[i + 2], n[i + 3]];
            const p = [n[i + 4], n[i + 5]];
            segs.push({ t: 'C', a: cur, c1, c2, p });
            cur = p;
          }
        }
      }
      return segs;
    };
    const chordDist = (q, a, b) => {
      const dx = b[0] - a[0];
      const dy = b[1] - a[1];
      return Math.abs((q[0] - a[0]) * dy - (q[1] - a[1]) * dx) / (Math.hypot(dx, dy) || 1);
    };
    // straight runs longer than 70 (x unit) become n smooth half-waves, amplitude min(11, 0.035 len), alternating sides
    const rebuild = (d, mapX, mapY, unit) => {
      let out = '';
      for (const s of parse(d)) {
        if (s.t === 'M') {
          out += `M${f(mapX(s.p[0], s.p[1]))},${f(mapY(s.p[1]))}`;
          continue;
        }
        const a = [mapX(s.a[0], s.a[1]), mapY(s.a[1])];
        const p = [mapX(s.p[0], s.p[1]), mapY(s.p[1])];
        const len = Math.hypot(p[0] - a[0], p[1] - a[1]);
        if (s.t === 'C') {
          const c1 = [mapX(s.c1[0], s.c1[1]), mapY(s.c1[1])];
          const c2 = [mapX(s.c2[0], s.c2[1]), mapY(s.c2[1])];
          const straight = len > 70 * unit && chordDist(c1, a, p) < 3 * unit && chordDist(c2, a, p) < 3 * unit;
          if (!straight) {
            out += ` C${f(c1[0])},${f(c1[1])} ${f(c2[0])},${f(c2[1])} ${f(p[0])},${f(p[1])}`;
            continue;
          }
        }
        if (len <= 70 * unit) {
          out += ` L${f(p[0])},${f(p[1])}`;
          continue;
        }
        const n = Math.max(1, Math.round(len / (280 * unit)));
        const amp = Math.min(11 * unit, len * 0.035);
        const ux = (p[0] - a[0]) / len;
        const uy = (p[1] - a[1]) / len;
        for (let i = 0; i < n; i++) {
          const t0 = i / n;
          const t1 = (i + 1) / n;
          const side = i % 2 ? -1 : 1;
          const q0 = [a[0] + (p[0] - a[0]) * t0, a[1] + (p[1] - a[1]) * t0];
          const q1 = [a[0] + (p[0] - a[0]) * t1, a[1] + (p[1] - a[1]) * t1];
          const k = (0.36 * len) / n;
          const o = amp * side * 1.33;
          const c1 = [q0[0] + ux * k - uy * o, q0[1] + uy * k + ux * o];
          const c2 = [q1[0] - ux * k - uy * o, q1[1] - uy * k + ux * o];
          out += ` C${f(c1[0])},${f(c1[1])} ${f(c2[0])},${f(c2[1])} ${f(q1[0])},${f(q1[1])}`;
        }
      }
      return out;
    };
    const pullIn = (x) => 20 + (x * 350) / 390;
    const phone = () => {
      let run = 0;
      document.querySelectorAll('.st-land__beeline').forEach((svg) => {
        const path = svg.querySelector('path');
        if (!path) return;
        if (!svg.dataset.vb0) svg.dataset.vb0 = svg.getAttribute('viewBox') || '';
        let route = path.dataset.raw || null;
        const top = svg.dataset.top;
        if (top) {
          const inner = svg.parentElement;
          const k = inner.getBoundingClientRect().width / 390;
          const h = k ? svg.getBoundingClientRect().height / k : 0;
          route = null;
          if (h > 0) {
            const head = inner.querySelector('.st-ch__headline');
            const dy = head ? Math.max(0, (head.offsetTop - parseFloat(svg.dataset.head) * k) / k) : 0;
            const bot = svg.dataset.bot ? ` ${shift(svg.dataset.bot, h)}` : '';
            route = `${shift(top, dy)} L${svg.dataset.x},${(h + parseFloat(svg.dataset.yb)).toFixed(1)}${bot}`;
            svg.setAttribute('viewBox', `0 0 390 ${h.toFixed(1)}`);
          }
        }
        if (route) path.setAttribute('d', rebuild(route, pullIn, (y) => y, 1));
        path.style.strokeDashoffset = String(-(run % DASH));
        run += path.getTotalLength();
      });
    };
    // ---- laptop (>= 1024; owner v12.1c / v12.1d, qa/desktop/owner-v12/README.md §B): ONE flowing line for the whole
    // landing, computed from the live layout (st-fable's laptop() in beecur.js, ported): 1. every section's route
    // (data-raw, the untouched 390-frame route) is mapped onto its content frame (chapters: the copy frame ± 64 px; cream
    // sections: the page frame, --pgw) and concatenated in page coordinates, the first 18 % of each blending from the
    // previous frame; 2. a Gaussian pre-smooth (sigma 160 px); 3. each crossed cluster of copy boxes is detoured on its
    // cheaper side; 4. rest shape = re-smooth (sigma 36) + a meander (12 / 560); 5. an elastic band, repelled where the
    // signed distance to copy boxes, art ink (alpha > 12) or the 8 px screen-edge band is under 18 px; spurs cut, ironed,
    // settled on a fine meander; 6. one Catmull-Rom spline, shown by every section's SVG through its own slice of the
    // page, so the dashes run on across the joins.
    const CELL = 6;
    const CLR = 18;
    const STEP = 8;
    const COPY_SEL =
      '.st-ch__note, .st-ch__headline text, .st-ch__nail, .st-ch__name, .st-ch__pill, .st-ch__caption, h1, h2, h3, h4, p, li, a, button, [class*="pill"], [class*="card"], [class*="chip"], [class*="board"], [class*="__cta"], [class*="tiles__"], .st-land__box, .st-land__hand, .st-land__cards, .st-land img:not(.st-land__art img)';
    const ART_SEL = '.st-land__art img, .st-land__card img';
    const vis = (e) => {
      const cs = getComputedStyle(e);
      return cs.display !== 'none' && cs.visibility !== 'hidden';
    };
    const smooth = (t) => (t <= 0 ? 0 : t >= 1 ? 1 : t * t * (3 - 2 * t));
    const mapOnly = (d, mapX, mapY) =>
      d.replace(/(-?\d+(?:\.\d+)?),(-?\d+(?:\.\d+)?)/g, (m, x, y) => `${f(mapX(+x, +y))},${f(mapY(+y))}`);
    const sampleD = (path, step) => {
      const L = path.getTotalLength();
      const n = Math.max(2, Math.ceil(L / step));
      const P = [];
      for (let i = 0; i <= n; i++) {
        const q = path.getPointAtLength((L * i) / n);
        P.push([q.x, q.y]);
      }
      return P;
    };
    const gauss = (P, sigma, step) => {
      const r = Math.ceil((2.5 * sigma) / step);
      const w = [];
      for (let k = -r; k <= r; k++) w.push(Math.exp(-((k * step) ** 2) / (2 * sigma * sigma)));
      return P.map((p, i) => {
        let sx = 0;
        let sy = 0;
        let sw = 0;
        for (let k = -r; k <= r; k++) {
          const j = Math.min(P.length - 1, Math.max(0, i + k));
          sx += P[j][0] * w[k + r];
          sy += P[j][1] * w[k + r];
          sw += w[k + r];
        }
        return [sx / sw, sy / sw];
      });
    };
    const resample = (P, step) => {
      const out = [P[0]];
      let acc = 0;
      for (let i = 1; i < P.length - 1; i++) {
        acc += Math.hypot(P[i][0] - P[i - 1][0], P[i][1] - P[i - 1][1]);
        if (acc >= step) {
          out.push(P[i]);
          acc = 0;
        }
      }
      out.push(P[P.length - 1]);
      return out;
    };
    const splineD = (P) => {
      let d = `M${f(P[0][0])},${f(P[0][1])}`;
      for (let i = 0; i < P.length - 1; i++) {
        const p0 = P[i - 1] || P[i];
        const p1 = P[i];
        const p2 = P[i + 1];
        const p3 = P[i + 2] || p2;
        d += ` C${f(p1[0] + (p2[0] - p0[0]) / 6)},${f(p1[1] + (p2[1] - p0[1]) / 6)} ${f(p2[0] - (p3[0] - p1[0]) / 6)},${f(p2[1] - (p3[1] - p1[1]) / 6)} ${f(p2[0])},${f(p2[1])}`;
      }
      return d;
    };
    // a meander of the given amplitude / wavelength along the line's normal, tapered over `taper` px at both ends
    const meander = (P, amp, wave, phase, taper) => {
      let s = 0;
      const Sd = P.map((p, i) => (i ? (s += Math.hypot(p[0] - P[i - 1][0], p[1] - P[i - 1][1])) : 0));
      const tot = s || 1;
      return P.map((p, i) => {
        if (i === 0 || i === P.length - 1) return p;
        const q0 = P[i - 1];
        const q1 = P[i + 1];
        const tx = q1[0] - q0[0];
        const ty = q1[1] - q0[1];
        const tl = Math.hypot(tx, ty) || 1;
        const t = taper ? Math.max(0, Math.min(1, Sd[i] / taper, (tot - Sd[i]) / taper)) : 1;
        const off = amp * Math.sin((2 * Math.PI * Sd[i]) / wave + phase) * t;
        return [p[0] - (ty / tl) * off, p[1] + (tx / tl) * off];
      });
    };
    const lap = (R) =>
      R.map((p, i) => (i === 0 || i === R.length - 1 ? [0, 0] : [(R[i - 1][0] + R[i + 1][0]) / 2 - p[0], (R[i - 1][1] + R[i + 1][1]) / 2 - p[1]]));

    const drawLaptop = () => {
      const secs = [...document.querySelectorAll('.st-land')];
      if (!secs.length) return;
      const top0 = secs[0].getBoundingClientRect().top;
      const W = secs[0].getBoundingClientRect().width;
      const PH = secs[secs.length - 1].getBoundingClientRect().bottom - top0;
      // ---- obstacle field for the whole landing (page coordinates): copy boxes, art ink, screen-edge band ----
      const gw = Math.ceil(W / CELL);
      const gh = Math.ceil(PH / CELL);
      const N = gw * gh;
      const g = new Uint8Array(N);
      const ink = new Uint8Array(N);
      const mark = (l, t, r, b) => {
        const x0 = Math.max(0, Math.floor(l / CELL));
        const x1 = Math.min(gw - 1, Math.ceil(r / CELL));
        const y0 = Math.max(0, Math.floor(t / CELL));
        const y1 = Math.min(gh - 1, Math.ceil(b / CELL));
        for (let y = y0; y <= y1; y++) for (let x = x0; x <= x1; x++) g[y * gw + x] = 1;
      };
      const copy = [];
      secs.forEach((sec) => {
        const sr = sec.getBoundingClientRect();
        sec.querySelectorAll(COPY_SEL).forEach((e) => {
          if (!vis(e)) return;
          const b = e.getBoundingClientRect();
          if (!b.width || !b.height || b.width * b.height > sr.width * sr.height * 0.5) return;
          const R = { l: b.left, t: b.top - top0, r: b.right, b: b.bottom - top0 };
          copy.push(R);
          mark(R.l, R.t, R.r, R.b);
        });
      });
      const cv = document.createElement('canvas');
      cv.width = gw;
      cv.height = gh;
      const cx = cv.getContext('2d', { willReadFrequently: true });
      secs.forEach((sec) => {
        const sr = sec.getBoundingClientRect();
        cx.save();
        cx.beginPath();
        cx.rect(0, (sr.top - top0) / CELL, gw, sr.height / CELL);
        cx.clip();
        sec.querySelectorAll(ART_SEL).forEach((img) => {
          if (!img.complete || !img.naturalWidth || !vis(img.closest('.st-land__art') || img)) return;
          const b = img.getBoundingClientRect();
          const mir = String(getComputedStyle(img).scale || '').trim().startsWith('-1');
          const x = b.left / CELL;
          const y = (b.top - top0) / CELL;
          const w = b.width / CELL;
          const h = b.height / CELL;
          cx.save();
          if (mir) {
            cx.translate(x + w, y);
            cx.scale(-1, 1);
            cx.drawImage(img, 0, 0, w, h);
          } else cx.drawImage(img, x, y, w, h);
          cx.restore();
        });
        cx.restore();
      });
      try {
        const A = cx.getImageData(0, 0, gw, gh).data;
        for (let i = 0; i < N; i++) if (A[i * 4 + 3] > 12) ink[i] = 1;
      } catch (e) {
        // art from another origin taints the canvas: the line then keeps clear of copy and edges only
      }
      for (let i = 0; i < N; i++) if (ink[i]) g[i] = 1;
      const E = Math.ceil(8 / CELL);
      for (let y = 0; y < gh; y++) {
        for (let x = 0; x < E; x++) {
          g[y * gw + x] = 1;
          g[y * gw + gw - 1 - x] = 1;
        }
      }
      const chamfer = (src) => {
        const d = new Float32Array(N);
        for (let i = 0; i < N; i++) d[i] = src[i] ? 0 : 1e9;
        for (let y = 0; y < gh; y++) {
          for (let x = 0; x < gw; x++) {
            const i = y * gw + x;
            let v = d[i];
            if (x > 0) v = Math.min(v, d[i - 1] + 1);
            if (y > 0) {
              v = Math.min(v, d[i - gw] + 1);
              if (x > 0) v = Math.min(v, d[i - gw - 1] + 1.414);
              if (x < gw - 1) v = Math.min(v, d[i - gw + 1] + 1.414);
            }
            d[i] = v;
          }
        }
        for (let y = gh - 1; y >= 0; y--) {
          for (let x = gw - 1; x >= 0; x--) {
            const i = y * gw + x;
            let v = d[i];
            if (x < gw - 1) v = Math.min(v, d[i + 1] + 1);
            if (y < gh - 1) {
              v = Math.min(v, d[i + gw] + 1);
              if (x < gw - 1) v = Math.min(v, d[i + gw + 1] + 1.414);
              if (x > 0) v = Math.min(v, d[i + gw - 1] + 1.414);
            }
            d[i] = v;
          }
        }
        return d;
      };
      const free = new Uint8Array(N);
      for (let i = 0; i < N; i++) free[i] = g[i] ? 0 : 1;
      const dOut = chamfer(g);
      const dIn = chamfer(free);
      const sd = new Float32Array(N);
      for (let i = 0; i < N; i++) sd[i] = (g[i] ? -dIn[i] : dOut[i]) * CELL;
      // signed distance (px) to the nearest obstacle, bilinear
      const field = (x, y) => {
        const fx = Math.min(gw - 1.001, Math.max(0, x / CELL - 0.5));
        const fy = Math.min(gh - 1.001, Math.max(0, y / CELL - 0.5));
        const x0 = Math.floor(fx);
        const y0 = Math.floor(fy);
        const tx = fx - x0;
        const ty = fy - y0;
        const i = y0 * gw + x0;
        return sd[i] * (1 - tx) * (1 - ty) + sd[i + 1] * tx * (1 - ty) + sd[i + gw] * (1 - tx) * ty + sd[i + gw + 1] * tx * ty;
      };
      // one relaxation step of point (x, y): toward the rest shape's bending, pushed out of the clearance zone
      const repel = (x, y, inside, outside, gain, lift) => {
        const v = field(x, y);
        if (v >= CLR) return [x, y];
        const gx = field(x + 4, y) - field(x - 4, y);
        const gy = field(x, y + 4) - field(x, y - 4);
        const gl = Math.hypot(gx, gy) || 1;
        const stp = Math.min(v < 0 ? inside : outside, (CLR - v) * gain + lift);
        return [x + (gx / gl) * stp, y + (gy / gl) * stp];
      };
      // ---- 1. every section's route on its content frame, concatenated ----
      const tmp = document.createElementNS(NS, 'svg');
      tmp.setAttribute('style', 'position:absolute;width:0;height:0;overflow:hidden');
      const tp = document.createElementNS(NS, 'path');
      tmp.appendChild(tp);
      document.body.appendChild(tmp);
      const probe = (sec, css) => {
        const d = document.createElement('div');
        d.style.cssText = `position:absolute;${css}`;
        sec.appendChild(d);
        const b = d.getBoundingClientRect();
        d.remove();
        return b;
      };
      let P = [];
      let prev = null;
      secs.forEach((sec) => {
        const r = sec.getBoundingClientRect();
        const oy = r.top - top0;
        const inner = sec.querySelector('.st-land__inner');
        let frame;
        if (sec.classList.contains('st-ch') && inner) {
          const ib = inner.getBoundingClientRect();
          frame = { o: ib.left - r.left - 64, w: ib.width + 128 };
        } else {
          const gu = Math.min(Math.max(32, W * 0.04), 64);
          const fw = probe(sec, 'width:var(--pgw)').width || Math.min(1240, W - 2 * gu);
          frame = { o: (W - fw) / 2, w: fw };
        }
        const src = sec.querySelector('.st-land__beeline');
        const p0 = src && src.querySelector('path');
        if (!p0) {
          prev = frame;
          return;
        }
        const vb = (src.dataset.vb0 || src.getAttribute('viewBox') || '0 0 390 620').split(/\s+/).map(Number);
        const own = r.height - probe(sec, 'height:calc(var(--nc) * var(--kt, var(--k)))').height;
        const from = prev || frame;
        const T = 0.18 * vb[3];
        const mapX = (x, y) => {
          const t = smooth(y / T);
          return from.o + (frame.o - from.o) * t + (x / 390) * (from.w + (frame.w - from.w) * t);
        };
        const mapY = (y) => oy + (y / vb[3]) * own;
        tp.setAttribute('d', mapOnly(p0.dataset.raw || p0.getAttribute('d'), mapX, mapY));
        const S = sampleD(tp, STEP);
        if (P.length && Math.hypot(S[0][0] - P[P.length - 1][0], S[0][1] - P[P.length - 1][1]) < 3) S.shift();
        P.push(...S);
        prev = frame;
      });
      tmp.remove();
      if (P.length < 4) return;
      const L = P.length;
      const a0 = P[0];
      const a1 = P[L - 1];
      // ---- 2. global pre-smooth ----
      P = gauss(P, 160, STEP);
      P[0] = a0;
      P[L - 1] = a1;
      // ---- 3. topology: each crossed cluster of copy boxes (18 px zones that touch) is detoured on one side ----
      const CL = copy.map((R) => ({ l: R.l - CLR, r: R.r + CLR, t: R.t - CLR, b: R.b + CLR }));
      for (let merged = true; merged; ) {
        merged = false;
        outer: for (let u = 0; u < CL.length; u++) {
          for (let v = u + 1; v < CL.length; v++) {
            const A = CL[u];
            const B = CL[v];
            if (A.l < B.r && B.l < A.r && A.t < B.b && B.t < A.b) {
              CL[u] = { l: Math.min(A.l, B.l), r: Math.max(A.r, B.r), t: Math.min(A.t, B.t), b: Math.max(A.b, B.b) };
              CL.splice(v, 1);
              merged = true;
              break outer;
            }
          }
        }
      }
      CL.forEach((X) => {
        const inX = (p) => p[0] > X.l && p[0] < X.r && p[1] > X.t && p[1] < X.b;
        let i = 1;
        while (i < L - 1) {
          if (!inX(P[i])) {
            i++;
            continue;
          }
          let j = i;
          while (j < L - 1 && inX(P[j])) j++;
          const A0 = P[i - 1];
          const B0 = P[Math.min(L - 1, j)];
          const vert = Math.abs(B0[1] - A0[1]) >= Math.abs(B0[0] - A0[0]);
          // a vertical run goes round left / right, a horizontal one over / under; the cheaper clear side wins
          const sides = vert ? [(p) => [X.l, p[1]], (p) => [X.r, p[1]]] : [(p) => [p[0], X.t], (p) => [p[0], X.b]];
          let best = sides[0];
          let bc = 1e12;
          sides.forEach((fn) => {
            let c = 0;
            let bad = 0;
            for (let k = i; k < j; k++) {
              const q = fn(P[k]);
              c += Math.hypot(q[0] - P[k][0], q[1] - P[k][1]);
              if (field(q[0], q[1]) < CLR * 0.6) bad++;
            }
            c += bad * 400;
            if (c < bc) {
              bc = c;
              best = fn;
            }
          });
          for (let k = i; k < j; k++) P[k] = best(P[k]);
          i = j + 1;
        }
      });
      // ---- 4. rest shape: re-smooth + meander ----
      P = gauss(P, 36, STEP);
      P[0] = a0;
      P[L - 1] = a1;
      P = meander(P, 12, 560, 0, 120);
      // ---- 5. elastic band ----
      const lapR = lap(P);
      for (let it = 0; it < 420; it++) {
        const Q = P.map((p) => p.slice());
        for (let i = 1; i < L; i++) {
          const nx = P[i + 1] || [2 * P[i][0] - P[i - 1][0], 2 * P[i][1] - P[i - 1][1]];
          const lx = (P[i - 1][0] + nx[0]) / 2 - P[i][0];
          const ly = (P[i - 1][1] + nx[1]) / 2 - P[i][1];
          Q[i] = repel(P[i][0] + 0.5 * (lx - lapR[i][0]), P[i][1] + 0.5 * (ly - lapR[i][1]), 12, 5, 0.45, 0.5);
