{% comment %}
  Section contract.
  "Start a talk" panel, board 4 frame 2 (spec/conversation.md), under a thread. The heading and sub are settings
  (TLK-050/051). Inside is the same anonymous composer as the hub (st-talk-composer, mode "panel"): she picks a topic
  (or types her own), writes and taps Post once. There is no name, email or login, and the talk goes live at once
  (or is held for a quick check). Renders on talk_thread pages, and on the blog named in "blog_handle" when it is
  placed there.
  @example
  <!-- templates/metaobject/talk_thread.json, after the thread section -->
{% endcomment %}

{%- capture live_flag -%}{%- render 'st-talk-live' -%}{%- endcapture -%}
{%- liquid
  assign live = false
  if live_flag == 'on'
    assign live = true
  endif
-%}
{%- liquid
  assign is_talks = false
  if metaobject and metaobject.system.type == 'talk_thread'
    assign is_talks = true
  elsif blog.handle == section.settings.blog_handle and article == blank
    assign is_talks = true
  endif
  assign chip_handles = ''
  assign chip_order = section.settings.chip_order | split: ','
  for wanted_raw in chip_order
    assign wanted = wanted_raw | strip
    if wanted != blank and wanted != 'all'
      assign chip_handles = chip_handles | append: wanted | append: ','
    endif
  endfor
-%}

{%- if is_talks -%}
  <div class="st-tform" id="start-a-talk">
    <h2 class="st-tform__heading">{{ section.settings.heading | escape }}</h2>
    {%- if section.settings.sub != blank -%}
      {%- assign sub_parts = section.settings.sub | escape | split: '. ' -%}
      <p class="st-tform__sub">
        {{- sub_parts.first }}{% if sub_parts.size > 1 %}.<br>{{ sub_parts | slice: 1, 9 | join: '. ' }}{% endif -%}
      </p>
    {%- endif -%}
    {%- render 'st-talk-composer', mode: 'panel', topics: chip_handles, current: '', id: section.id, live: live -%}
  </div>
{%- endif -%}

{% stylesheet %}
  /* Panel x 18–375, radius 12, #fdf1f0, id start-a-talk (conversation.md). */
  .st-tform {
    display: grid;
    gap: 18px;
    max-width: 40rem;
    margin: 30px auto 0;
    padding: 22px 20px 24px 22px;
    border-radius: 12px;
    background: #fdf1f0;
    color: #1a1a2e;
    font-family: var(--font-ui);
    scroll-margin-block-start: 84px;
  }

  @media screen and (max-width: 749px) {
    .st-tform {
      margin-inline: 18px 15px;
    }
  }

  /* Desktop: the top of a thread page's right column (placed by st-talks-thread), level with the thread's avatar. */
  @media screen and (min-width: 1024px) {
    .st-tform-section > .st-tform {
      max-width: none;
      margin: 62px 0 0;
    }
  }

  /* H2: the board ink (186 × 34 at x 41, y 1037) is Source Serif 4 Black at ~46 px, −0.06em. #b00818. */
  .st-tform__heading {
    margin: 0;
    color: #b00818;
    font-family: var(--font-shop-display);
    font-weight: 900;
    font-size: 46px;
    line-height: 1.05;
    letter-spacing: -0.06em;
  }

  /* Sub: DM Sans 400, muted; the board line "Small moments. Open conversations." is 308 px wide = 18 px. */
  .st-tform__sub {
    margin: -6px 0 0;
    color: var(--st-muted-text);
    font-size: 18px;
    line-height: 1.3;
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Small Talk start a talk",
  "tag": "div",
  "class": "st-tform-section",
  "settings": [
    { "type": "text", "id": "blog_handle", "label": "Talks blog handle", "default": "the-talks" },
    { "type": "text", "id": "heading", "label": "Heading (TLK-050)", "default": "Start a talk" },
    { "type": "text", "id": "sub", "label": "Sub (TLK-051)", "default": "Share your perspective. Small moments. Open conversations." },
    { "type": "text", "id": "chip_order", "label": "Topics offered (talk topic handles, comma-separated)", "default": "plot-twists, tiny-wins, nail-talk, something-else" }
  ]
}
{% endschema %}
