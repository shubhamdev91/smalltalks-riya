{% doc %}
  The talks composer, UX v4: the writing box is the hero ("we need them to spill"). Start a talk with no name, email
  or login: she writes in the big box (her first line becomes the headline), keeps or changes the ONE pre-selected
  topic, and taps "post it" once; st-talks.js posts it to the talks backend and shows it straight away. Inside the box,
  "need a nudge?" drops in a starter for the chosen topic (TLK-175/158/176). Small print: "posting as {alias} ·
  shuffle" (TLK-104) and the one-line rule (TLK-143). Her alias, avatar set and device id live in localStorage only.
  Posting off: the pre-launch line (TLK-153) renders instead, so nobody meets a box that can't post.

  @param {string} topics - Pickable topic handles in order, comma-separated (talk_topic metaobjects).
  @param {string} [current] - Topic handle to preselect (topic pages); default the first topic.
  @param {string} id - Unique suffix for element ids (section.id).
  @param {boolean} [live] - Posting is switched on (snippet st-talk-live).

  @example
  {% render 'st-talk-composer', topics: 'plot-twists,tiny-wins', current: '', id: section.id, live: live %}
{% enddoc %}

{%- liquid
  assign form_id = 'StCompose-' | append: id
  assign handles = topics | remove: ' ' | split: ','
  assign picked = ''
  for h in handles
    if h == current
      assign picked = h
    endif
  endfor
  if picked == blank and current == 'something-else'
    assign picked = '__own'
  endif
-%}
{%- unless live -%}
  <p class="tk-soon">{{ 'small_talk.talks.live.v4.prelaunch' | t }}</p>
{%- else -%}
<form class="tk-hero" id="{{ form_id }}" data-st-compose novalidate>
  <div class="tk-hero__box">
    <label class="visually-hidden" for="{{ form_id }}-text">{{ 'small_talk.talks.live.v4.box_label' | t }}</label>
    <textarea
      id="{{ form_id }}-text"
      class="tk-hero__input"
      name="text"
      rows="5"
      maxlength="1200"
      placeholder=" "
      aria-describedby="{{ form_id }}-hint {{ form_id }}-status"
    ></textarea>
    <p class="tk-hero__ph" aria-hidden="true">
      {{- 'small_talk.talks.live.v4.box_label' | t -}}
      <small id="{{ form_id }}-hint">{{ 'small_talk.talks.live.v4.box_hint' | t }}</small>
    </p>
    <button type="button" class="tk-pill tk-pill--ghost tk-hero__nudge" data-st-nudge>
      <span>
        <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M6 1.5v3M6 7.5v3M1.5 6h3M7.5 6h3"/></svg>
        {{- 'small_talk.talks.live.v4.nudge' | t -}}
      </span>
    </button>
  </div>

  <div class="tk-hero__row">
    <span class="tk-pill tk-topic">
      <label class="visually-hidden" for="{{ form_id }}-topic">{{ 'small_talk.talks.live.v4.topic_label' | t }}</label>
      <select id="{{ form_id }}-topic" name="topic" data-st-topic>
        {%- for h in handles -%}
          {%- assign topic = metaobjects.talk_topic[h] -%}
          {%- if topic and topic.pickable.value == true and h != 'something-else' -%}
            <option value="{{ h | escape }}"{% if h == picked %} selected{% endif %}>{{ topic.label.value | escape }}</option>
          {%- endif -%}
        {%- endfor -%}
        <option value="__own"{% if picked == '__own' %} selected{% endif %}>{{ 'small_talk.talks.live.v4.topic_own' | t }}</option>
      </select>
      <svg viewBox="0 0 12 12" aria-hidden="true" focusable="false"><path d="M3 4.5 L6 7.5 L9 4.5"/></svg>
    </span>
    <button type="submit" class="tk-post">{{ 'small_talk.talks.live.v4.post' | t }}</button>
  </div>

  <div class="tk-hero__own" data-st-own{% unless picked == '__own' %} hidden{% endunless %}>
    <label class="visually-hidden" for="{{ form_id }}-own">{{ 'small_talk.talks.live.v4.topic_own_placeholder' | t }}</label>
    <input
      id="{{ form_id }}-own"
      type="text"
      class="tk-field"
      name="topic_own"
      maxlength="30"
      autocomplete="off"
      placeholder="{{ 'small_talk.talks.live.v4.topic_own_placeholder' | t | escape }}"
    >
  </div>

  <div class="st-hp" aria-hidden="true">
    <label>Website <input type="text" name="website" tabindex="-1" autocomplete="off"></label>
  </div>

  <p class="tk-status" id="{{ form_id }}-status" role="status" data-st-status></p>

  <div class="tk-hero__fine">
    <p class="tk-as">
      <span data-st-as>{{ 'small_talk.talks.live.v4.posting_as' | t: alias: '…' }}</span>
      {{ ' · ' -}}
      <button type="button" class="tk-link" data-st-shuffle>{{ 'small_talk.talks.live.v4.shuffle' | t }}</button>
    </p>
    <p>{{ 'small_talk.talks.live.v4.rules_line' | t }}</p>
  </div>
  <noscript><p class="tk-hero__fine">{{ 'small_talk.talks.live.v4.noscript' | t }}</p></noscript>
</form>
{%- endunless -%}
