{% comment %}
  Section contract.
  House rules for the talks (TLK-070…077 + TLK-148 privacy), talks UX v4, on the hub, topic pages and threads
  (#house-rules). Phones: one collapsed row, "house rules · 30-second read" (TLK-166), that opens to every rule.
  Desktop (1024+): a sticky card in the right rail (placed by st-talks-list / -thread): the heading and the first three
  rules, then "all house rules ›" (TLK-183; accessible name "read all the house rules") opens the rest. "{email}" in the report line becomes a mailto: link to the store's
  contact email (TLK-076). The support line turns the two helpline numbers into tel: links (TLK-077). The moderation
  line follows the posting switch (TLK-075 open / TLK-154 before posting opens). Renders on the blog named in
  "blog_handle" and on talk_thread / talk_topic pages.
  @example
  <!-- templates/blog.json, metaobject/talk_thread.json, metaobject/talk_topic.json, last section -->
{% endcomment %}

{%- capture live_flag -%}{%- render 'st-talk-live' -%}{%- endcapture -%}
{%- liquid
  assign live = false
  if live_flag == 'on'
    assign live = true
  endif
  assign is_talks = false
  if blog.handle == section.settings.blog_handle and article == blank
    assign is_talks = true
  elsif metaobject
    if metaobject.system.type == 'talk_thread' or metaobject.system.type == 'talk_topic'
      assign is_talks = true
    endif
  endif

  assign report = section.settings.report | escape
  if shop.email != blank
    assign email_link = '<a href="mailto:' | append: shop.email | append: '">' | append: shop.email | append: '</a>'
    assign report = report | replace: '{email}', email_link
  else
    assign report = ''
  endif

  assign support = section.settings.support | escape
  assign tel_1 = section.settings.support_tel_1 | strip
  assign tel_2 = section.settings.support_tel_2 | strip
  if tel_1 != blank and support contains tel_1
    assign href_1 = tel_1 | remove: '-' | remove: ' '
    assign link_1 = '<a href="tel:' | append: href_1 | append: '">@@TEL1@@</a>'
    assign support = support | replace_first: tel_1, link_1
  endif
  if tel_2 != blank and support contains tel_2
    assign href_2 = tel_2 | remove: '-' | remove: ' '
    assign link_2 = '<a href="tel:' | append: href_2 | append: '">@@TEL2@@</a>'
    assign support = support | replace_first: tel_2, link_2
  endif
  assign support = support | replace: '@@TEL1@@', tel_1 | replace: '@@TEL2@@', tel_2

  assign rules = '' | split: ''
  for i in (1..4)
    assign key = 'rule_' | append: i
    if section.settings[key] != blank
      assign rule = section.settings[key] | split: '@@'
      assign rules = rules | concat: rule
    endif
  endfor

  assign moderation = section.settings.moderation
  unless live
    assign moderation = section.settings.moderation_prelaunch | default: section.settings.moderation
  endunless

  assign toggle = 'small_talk.talks.live.v4.rules_toggle' | t | split: ' · '
-%}

{%- if is_talks -%}
  {%- capture rest -%}
    {%- if section.settings.privacy != blank -%}<p>{{ section.settings.privacy | escape }}</p>{%- endif -%}
    {%- if moderation != blank -%}<p>{{ moderation | escape }}</p>{%- endif -%}
    {%- if report != blank -%}<p>{{ report }}</p>{%- endif -%}
    {%- if support != blank -%}<p class="tk-rules__support">{{ support }}</p>{%- endif -%}
  {%- endcapture -%}
  <div class="tk tk-rulesbox" id="house-rules">
    <details class="tk-rules tk-rules--phone">
      <summary>
        <span>{{ toggle.first | escape }}</span>
        {%- if toggle.size > 1 %}<span class="tk-rules__time">{{ toggle.last | escape }} ›</span>{% endif -%}
      </summary>
      <div class="tk-rules__all">
        {%- if rules.size > 0 -%}
          <ul class="tk-rules__list">
            {%- for rule in rules -%}<li>{{ rule | escape }}</li>{%- endfor -%}
          </ul>
        {%- endif -%}
        {{ rest }}
      </div>
    </details>

    <section class="tk-rules tk-rules--card" aria-labelledby="StRules-{{ section.id }}">
      <h2 class="tk-rules__h" id="StRules-{{ section.id }}">{{ section.settings.heading | escape }}</h2>
      {%- if rules.size > 0 -%}
        <ul class="tk-rules__list">
          {%- for rule in rules limit: 3 -%}<li>{{ rule | escape }}</li>{%- endfor -%}
        </ul>
      {%- endif -%}
      <details class="tk-rules__more">
        <summary>
          <span aria-hidden="true">{{ 'small_talk.talks.live.v4.rules_all' | t }} ›</span>
          <span class="visually-hidden">{{ 'small_talk.talks.live.v4.rules_all_label' | t }}</span>
        </summary>
        <div class="tk-rules__all">
          {%- if rules.size > 3 -%}
            <ul class="tk-rules__list">
              {%- for rule in rules offset: 3 -%}<li>{{ rule | escape }}</li>{%- endfor -%}
            </ul>
          {%- endif -%}
          {{ rest }}
        </div>
      </details>
    </section>
  </div>
{%- endif -%}

{% stylesheet %}
  .tk-rulesbox {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 16px 32px;
    scroll-margin-block-start: calc(var(--st-header-h, 69px) + 16px);
  }

  .tk-rules--card {
    display: none;
  }

  .tk-rules--phone {
    border-top: 1px solid var(--tk-line);
    border-bottom: 1px solid var(--tk-line);
  }

  .tk-rules--phone > summary {
    display: flex;
    justify-content: space-between;
    align-items: center;
    gap: 12px;
    min-height: 52px;
    font-size: 15px;
    font-weight: 600;
    list-style: none;
    cursor: pointer;
  }

  .tk-rules summary::-webkit-details-marker,
  .tk-rules__more summary::-webkit-details-marker {
    display: none;
  }

  .tk-rules__time {
    color: var(--tk-muted);
    font-size: 13px;
    font-weight: 500;
  }

  .tk-rules summary:focus-visible {
    outline: 2px solid var(--tk-accent);
    outline-offset: 2px;
  }

  .tk-rules__all {
    display: grid;
    gap: 10px;
    padding: 0 0 16px;
    font-size: 14px;
    line-height: 1.45;
  }

  .tk-rules__all p {
    margin: 0;
  }

  .tk-rules__list {
    display: grid;
    gap: 6px;
    margin: 0;
    padding: 0;
    list-style: none;
    font-size: 14px;
    line-height: 1.45;
  }

  .tk-rules__list li {
    display: grid;
    grid-template-columns: 14px 1fr;
    gap: 6px;
  }

  .tk-rules__list li::before {
    content: '•';
    color: var(--tk-accent);
  }

  /* 44 px tall hit areas without moving the text. */
  .tk-rules a {
    display: inline-block;
    padding-block: 12px;
    margin-block: -12px;
    color: var(--tk-chip-ink);
    font-weight: 600;
    text-underline-offset: 3px;
    overflow-wrap: anywhere;
  }

  .tk-rules__support {
    padding: 12px 14px;
    border-radius: 12px;
    background: var(--tk-chip);
  }

  .tk-rules__support a {
    white-space: nowrap;
  }

  @media screen and (min-width: 1024px) {
    .tk-rulesbox {
      height: 100%;
      max-width: none;
      margin: 0;
      padding: 32px 0 64px;
    }

    .tk-rules--phone {
      display: none;
    }

    .tk-rules--card {
      position: sticky;
      top: calc(var(--st-header-h, 76px) + 24px);
      display: grid;
      gap: 12px;
      max-height: calc(100vh - var(--st-header-h, 76px) - 48px);
      overflow-y: auto;
      padding: 20px;
      border: 1px solid var(--tk-line);
      border-radius: 16px;
      background: #fff;
    }

    .tk .tk-rules__h {
      margin: 0;
      font-size: 17px;
      font-weight: 700;
    }

    .tk-rules__more > summary {
      display: inline-flex;
      align-items: center;
      min-height: 44px;
      color: var(--tk-chip-ink);
      font-size: 14px;
      font-weight: 700;
      list-style: none;
      cursor: pointer;
    }

    .tk-rules__more > summary:focus-visible {
      outline: 2px solid var(--tk-accent);
      outline-offset: 2px;
    }

    .tk-rules__more[open] > summary {
      display: none;
    }

    .tk-rules--card .tk-rules__all {
      padding: 0;
    }
  }
{% endstylesheet %}

{% schema %}
{
  "name": "Small Talk house rules",
  "tag": "div",
  "class": "st-trules-section",
  "settings": [
    { "type": "text", "id": "blog_handle", "label": "Talks blog handle", "default": "the-talks" },
    { "type": "text", "id": "heading", "label": "Heading (TLK-070)", "default": "house rules" },
    { "type": "text", "id": "rule_1", "label": "Rule 1 (TLK-071)", "default": "talk about situations, not people." },
    { "type": "text", "id": "rule_2", "label": "Rule 2 (TLK-072)", "default": "no real names, numbers, handles or links. nothing that could identify anyone." },
    { "type": "text", "id": "rule_3", "label": "Rule 3 (TLK-073)", "default": "no hate, harassment or bullying. no selling." },
    { "type": "text", "id": "rule_4", "label": "Rule 4 (TLK-074)", "default": "your alias is the only name anyone sees. we don’t ask for a name, email or account." },
    { "type": "textarea", "id": "privacy", "label": "Privacy line (TLK-148)", "default": "to stop spam, we keep a scrambled code for your device (never your IP address) and delete it within 30 days." },
    { "type": "textarea", "id": "moderation_prelaunch", "label": "Moderation before posting opens (TLK-154)", "info": "Shown instead of TLK-075 while the talks posting switch (snippet st-talk-live) is off.", "default": "once posting opens, talks and replies go live straight away. we take down whatever breaks these rules." },
    { "type": "textarea", "id": "moderation", "label": "Moderation (TLK-075)", "default": "talks and replies go live straight away. we take down whatever breaks these rules." },
    { "type": "textarea", "id": "report", "label": "How to report (TLK-076)", "info": "{email} becomes a link to the store's contact email.", "default": "tap report on anything that breaks these rules. three reports from different people and it’s hidden until we’ve checked it. something here about you? email {email} with the link and we’ll take it down." },
    { "type": "textarea", "id": "support", "label": "Support line (TLK-077)", "default": "if a talk gets heavy, you don’t have to carry it alone. call Tele-MANAS, India’s free 24×7 mental health helpline, on 14416 or 1800-891-4416." },
    { "type": "text", "id": "support_tel_1", "label": "Helpline number 1 (becomes a tel: link)", "default": "14416" },
    { "type": "text", "id": "support_tel_2", "label": "Helpline number 2 (becomes a tel: link)", "default": "1800-891-4416" }
  ]
}
{% endschema %}
