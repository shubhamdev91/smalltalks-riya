{% comment %}
  Section contract.
  the talks hub (blog template) and topic pages (metaobject/talk_topic template), talks UX v4 (owner-approved
  10 Oct, qa/talks-ux/README.md).
  - Header: the "the talks" wordmark as the H1 (TLK-001; V1, the owner's pick: snippets/st-talks-wordmark, the outlined
    SVG drawn from the header's sprite, with the heading as visually hidden text) and the promise (TLK-003).
  - The writing box is the hero (st-talk-composer): start a talk with no name, email or login.
  - Topic chips (TLK-005/006: all + the locked topics, st-talk-topics; "something else" never shows), "latest"
    (TLK-007), then one flat row per thread (st-talk-row), newest first, from the topic's `threads` list (talk_topic
    "all" on the hub). Draft entries never render. Honest empty states (TLK-013/161/163-165), "more talks" (TLK-015)
    and the sign-off (TLK-016).
  - Phones: a sticky "spill your tea" (TLK-004) scrolls to the box and focuses it; it hides while she types.
  - Desktop (1024+): #MainContent becomes the page grid: this section in a 720 px column, the house rules (a sibling
    section) in a 300 px rail; from 1280 the topics move to a side nav on the left.
  - Any other blog on this template (news) keeps its title and plain article rows (unchanged).
  @example
  <!-- templates/blog.json (blogs without a template suffix) and templates/metaobject/talk_topic.json -->
{% endcomment %}

{%- capture live_flag -%}{%- render 'st-talk-live' -%}{%- endcapture -%}
{%- liquid
  assign live = false
  if live_flag == 'on'
    assign live = true
  endif
  assign is_talks = false
  assign feed = nil
  assign current_topic = ''
  if metaobject and metaobject.system.type == 'talk_topic'
    assign is_talks = true
    assign feed = metaobject
    if metaobject.system.handle != 'all'
      assign current_topic = metaobject.system.handle
    endif
  elsif blog.handle == section.settings.blog_handle
    assign is_talks = true
    assign feed = metaobjects.talk_topic['all']
  endif

  assign hub_url = section.settings.hub_url | default: '/blogs/the-talks'
  if blog and is_talks
    assign hub_url = blog.url
  endif
  assign heading = blog.title | default: section.settings.heading
  assign cta_label = section.settings.cta_label | remove: '↗' | strip
  assign panel_text = section.settings.panel_text
-%}

{%- if is_talks -%}
  {%- liquid
    assign hidden = section.settings.hidden_topics | default: 'something-else' | remove: ' ' | split: ','
    assign pickable = ''
    assign wanted = section.settings.chip_order | remove: ' ' | split: ','
    for h in wanted
      if h != blank and h != 'all'
        unless hidden contains h
          assign pickable = pickable | append: h | append: ','
        endunless
      endif
    endfor
    assign topic_label = ''
    if current_topic != blank
      assign topic_label = feed.label.value | escape | prepend: '<span class="tk-lc">' | append: '</span>'
    endif
  -%}
  <section
    class="tk tk-hub{% unless live %} tk-hub--closed{% endunless %}"
    aria-labelledby="StTalks-{{ section.id }}"
    data-st-feed="{{ current_topic | default: 'all' }}"
    data-st-ago-strings
    data-ago-now="{{ 'small_talk.talks.live.v4.time.just_now' | t | escape }}"
    data-ago-minutes="{{ 'small_talk.talks.live.v4.time.minutes' | t: count: '__n__' | escape }}"
    data-ago-hours="{{ 'small_talk.talks.live.v4.time.hours' | t: count: '__n__' | escape }}"
    data-ago-days="{{ 'small_talk.talks.live.v4.time.days' | t: count: '__n__' | escape }}"
  >
    <aside class="tk-side">
      <div class="tk-side__in">
        {%- render 'st-talk-topics', variant: 'side', order: section.settings.chip_order, hide: section.settings.hidden_topics, current: current_topic, hub_url: hub_url, all_label: section.settings.all_label -%}
      </div>
    </aside>

    <div class="tk-main">
      <header class="tk-head">
        <h1 class="tk-wordmark" id="StTalks-{{ section.id }}">
          <span class="visually-hidden">{{ heading | escape }}</span>
          {%- render 'st-talks-wordmark' -%}
        </h1>
        {%- if section.settings.subheading != blank -%}
          <p class="tk-promise">{{ section.settings.subheading | escape }}</p>
        {%- endif -%}
      </header>

      <div id="start-a-talk" class="tk-start">
        {%- render 'st-talk-composer', topics: pickable, current: current_topic, id: section.id, live: live -%}
      </div>

      {%- render 'st-talk-topics', variant: 'chips', order: section.settings.chip_order, hide: section.settings.hidden_topics, current: current_topic, hub_url: hub_url, all_label: section.settings.all_label -%}

      <div class="tk-feedhead">
        <h2 class="tk-label">{{ section.settings.list_label | escape }}</h2>
      </div>

      {%- capture empty_state -%}
        {%- if current_topic != blank -%}
          <div class="tk-empty" data-st-empty>
            {%- if live -%}
              <p class="tk-empty__h">{{ 'small_talk.talks.live.v4.empty_title' | t }}</p>
              <p class="tk-empty__p">{{ 'small_talk.talks.live.v4.empty_line' | t: topic: '@@T@@' | replace: '@@T@@', topic_label }}</p>
              <a class="tk-cta tk-cta--inline" href="#start-a-talk" data-st-start>{{ 'small_talk.talks.live.v4.empty_cta' | t }}</a>
            {%- else -%}
              <p class="tk-empty__p">{{ 'small_talk.talks.live.v4.empty_topic_closed' | t: topic: '@@T@@' | replace: '@@T@@', topic_label }}</p>
            {%- endif -%}
          </div>
        {%- else -%}
          <div class="tk-empty" data-st-empty>
            <p class="tk-empty__p">
              {%- if live -%}{{ 'small_talk.talks.live.v4.empty' | t }}{%- else -%}{{ 'small_talk.talks.live.v4.prelaunch' | t }}{%- endif -%}
            </p>
          </div>
        {%- endif -%}
      {%- endcapture -%}

      {%- if feed and feed.threads.value != blank -%}
        {%- paginate feed.threads.value by section.settings.per_page -%}
          {%- assign shown = 0 -%}
          <ul class="tk-rows" role="list" data-st-list data-page="{{ paginate.current_page }}">
            {%- for thread in feed.threads.value -%}
              {%- if thread == blank or thread.title.value == blank -%}{%- continue -%}{%- endif -%}
              {%- assign shown = shown | plus: 1 -%}
              {%- render 'st-talk-row', thread: thread -%}
            {%- endfor -%}
          </ul>
          {%- if shown == 0 and paginate.current_page == 1 -%}{{ empty_state }}{%- endif -%}
          {%- if paginate.previous or paginate.next -%}
            <nav class="tk-more" aria-label="{{ 'content.pagination.nav_label' | t | escape }}">
              {%- if paginate.previous -%}
                <a href="{{ paginate.previous.url }}" class="tk-btn-ghost">{{ 'content.pagination.previous' | t }}</a>
              {%- endif -%}
              {%- if paginate.next -%}
                <a href="{{ paginate.next.url }}" class="tk-btn-ghost">{{ 'small_talk.talks.live.v4.more' | t }}</a>
              {%- endif -%}
            </nav>
          {%- endif -%}
        {%- endpaginate -%}
      {%- else -%}
        <ul class="tk-rows" role="list" data-st-list data-page="1"></ul>
        {{ empty_state }}
      {%- endif -%}

      {%- if panel_text != blank -%}
        <p class="tk-sign">{{ panel_text | escape }}</p>
      {%- endif -%}
    </div>

    {%- if live and cta_label != blank -%}
      <div class="tk-dock">
        <a class="tk-cta" href="#start-a-talk" data-st-start>
          {{- cta_label | escape -}}
          <svg viewBox="0 0 16 16" aria-hidden="true" focusable="false"><path d="M4 12 L12 4 M5.5 4 H12 V10.5"/></svg>
        </a>
      </div>
    {%- endif -%}
  </section>
  {%- render 'st-talk-config', endpoint: section.settings.endpoint, live: live -%}
  <script type="module" src="{{ 'st-talks.js' | asset_url }}" fetchpriority="low"></script>
{%- else -%}
  <section class="st-talks" aria-labelledby="StTalks-{{ section.id }}">
    <header class="st-talks__header">
      <h1 class="st-talks__title" id="StTalks-{{ section.id }}">{{ heading | escape }}</h1>
    </header>
    {%- paginate blog.articles by section.settings.per_page -%}
      <ul class="st-talks__list" role="list">
        {%- for article in blog.articles -%}
          <li class="st-trow">
            <a class="st-trow__link" href="{{ article.url }}">
              {%- render 'st-talk-avatar', article: article -%}
              <span class="st-trow__text">
                <span class="st-trow__meta">
                  <span class="st-trow__author">{{ article.author | escape }}</span>
                  {%- render 'st-talk-time', at: article.published_at -%}
                </span>
                <span class="st-trow__title">{{ article.title | escape }}</span>
              </span>
            </a>
          </li>
        {%- endfor -%}
      </ul>
      {%- if paginate.next -%}
        <nav class="st-talks__more" aria-label="{{ 'content.pagination.nav_label' | t | escape }}">
          <a href="{{ paginate.next.url }}" class="st-talks__more-link">{{ 'small_talk.talks.hub.more' | t }}</a>
        </nav>
      {%- endif -%}
    {%- endpaginate -%}
  </section>
  <script type="module" src="{{ 'st-talks.js' | asset_url }}" fetchpriority="low"></script>
{%- endif -%}

{% stylesheet %}
  /* ---------- the hub ---------- */
  .tk-hub {
    max-width: 720px;
    margin: 0 auto;
    padding: 12px 16px 96px;
  }

  .tk-hub--closed {
    padding-bottom: 32px;
  }

  /* The wordmark (TLK-001), V1 (owner's pick; qa/talks-ux/wordmark/V1-FINAL.md): the outlined SVG at 0.8377em of
     40 px (52 px desktop), ink, no swash, no arrow. */
  .tk .tk-wordmark {
    display: block;
    margin: 0 0 4px;
    color: #0d0b10;
    font-size: 40px;
    line-height: 1;
  }

  .tk-promise {
    margin: 4px 0 0;
    color: var(--tk-muted);
    font-size: 16px;
    line-height: 1.4;
  }

  .tk-start {
    scroll-margin-block-start: calc(var(--st-header-h, 69px) + 16px);
  }

  .tk-feedhead {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    margin: 16px 0 0;
    padding-bottom: 8px;
    border-bottom: 1px solid var(--tk-line);
  }

  .tk-empty {
    display: grid;
    justify-items: center;
    gap: 8px;
    padding: 36px 16px 32px;
    border-bottom: 1px solid var(--tk-line);
    text-align: center;
  }

  .tk-empty[hidden] {
    display: none;
  }

  .tk-empty p {
    margin: 0;
  }

  .tk-empty__h {
    font-size: 17px;
    font-weight: 600;
  }

  .tk-empty__p {
    color: var(--tk-muted);
  }

  .tk-sign {
    margin: 20px 0 0;
    color: var(--tk-muted);
    font-size: 14px;
    text-align: center;
  }

  /* "spill your tea" (TLK-004): the phone's sticky bar; safe-area aware; hidden while she types. */
  .tk-cta {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 10px;
    width: 100%;
    min-height: 52px;
    padding: 0 24px;
    border-radius: 999px;
    background: var(--tk-accent);
    color: #fff;
    font-family: var(--font-pill);
    font-weight: 600;
    font-size: 20px;
    line-height: 1;
    text-decoration: none;
  }

  .tk-cta svg {
    width: 15px;
    height: 15px;
    fill: none;
    stroke: currentColor;
    stroke-width: 2.4;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tk-cta--inline {
    width: auto;
    margin-top: 8px;
  }

  .tk-cta:focus-visible {
    outline: 2px solid var(--tk-ink);
    outline-offset: 3px;
  }

  .tk-dock {
    position: fixed;
    left: 0;
    right: 0;
    bottom: 0;
    z-index: 5;
    padding: 8px 16px calc(8px + env(safe-area-inset-bottom));
    border-top: 1px solid var(--tk-line);
    background: rgb(255 253 246 / 0.96);
  }

  .tk-typing .tk-dock {
    display: none;
  }

  /* Rows: flat, 1 px dividers; avatar 40 (44 desktop), meta, title (2 lines), reply count. */
  .tk-rows {
    display: grid;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .tk-r {
    border-bottom: 1px solid var(--tk-line);
    content-visibility: auto;
    contain-intrinsic-size: auto 104px;
  }

  .tk-row {
    display: grid;
    grid-template-columns: 40px minmax(0, 1fr);
    gap: 0 12px;
    padding: 12px 0;
    color: inherit;
    text-decoration: none;
    --st-tavatar-size: 40px;
  }

  .tk-row:focus-visible {
    outline: 2px solid var(--tk-accent);
    outline-offset: 2px;
  }

  .tk-row:hover .tk-row__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .tk-row__av {
    padding-top: 2px;
  }

  .tk-row__text {
    display: grid;
    min-width: 0;
  }

  .tk-row__title {
    display: -webkit-box;
    margin-top: 2px;
    overflow: hidden;
    color: var(--tk-ink);
    font-size: 17px;
    font-weight: 600;
    line-height: 1.3;
    overflow-wrap: anywhere;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
  }

  .tk-row__ex {
    display: none;
  }

  .tk-foot {
    display: flex;
    align-items: center;
    gap: 6px;
    margin-top: 4px;
    color: var(--tk-muted);
    font-size: 13px;
    font-weight: 500;
    line-height: 1.3;
  }

  .tk-foot svg {
    flex: none;
    width: 16px;
    height: 16px;
    fill: none;
    stroke: currentColor;
    stroke-width: 1.6;
    stroke-linecap: round;
    stroke-linejoin: round;
  }

  .tk-r.is-mine {
    animation: tk-in 420ms ease-out;
  }

  @keyframes tk-in {
    from { background: #fdecec; }
    to { background: transparent; }
  }

  .tk-r.is-pending .tk-row {
    cursor: default;
  }

  .tk-r.is-pending .tk-row__title {
    opacity: 0.65;
  }

  .tk-r__fail {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0 8px;
    padding: 0 0 12px 52px;
    color: #b00818;
    font-size: 14px;
  }

  @media (prefers-reduced-motion: reduce) {
    .tk-r.is-mine {
      animation: none;
    }
  }

  /* Desktop: meta + count on one line, the title on one line, a one-line excerpt. */
  @media screen and (min-width: 1024px) {
    .tk-row {
      grid-template-columns: 44px minmax(0, 1fr);
      gap: 0 14px;
      --st-tavatar-size: 44px;
    }

    .tk-row__text {
      grid-template-columns: minmax(0, 1fr) auto;
      column-gap: 16px;
    }

    .tk-row__text > .tk-meta {
      grid-column: 1;
      grid-row: 1;
      font-size: 14px;
    }

    .tk-row__text > .tk-foot {
      grid-column: 2;
      grid-row: 1;
      margin-top: 0;
      font-size: 14px;
    }

    .tk-row__title,
    .tk-row__ex {
      grid-column: 1 / -1;
    }

    .tk-row__title {
      font-size: 19px;
      -webkit-line-clamp: 1;
    }

    .tk-row__ex {
      display: -webkit-box;
      margin-top: 2px;
      overflow: hidden;
      color: var(--tk-muted);
      font-size: 17px;
      line-height: 1.45;
      -webkit-box-orient: vertical;
      -webkit-line-clamp: 1;
    }

    .tk-r__fail {
      padding-left: 58px;
    }
  }

  /* ---------- desktop: 720 px column + 300 px rail (house rules); side nav from 1280 ---------- */
  @media screen and (min-width: 1024px) {
    #MainContent:has(> .st-talks-section > .tk-hub) {
      display: grid;
      grid-template-columns: minmax(0, 720px) 300px;
      justify-content: center;
      align-items: start;
      column-gap: 40px;
      padding-inline: clamp(32px, 4vw, 64px);
    }

    #MainContent > .st-talks-section:has(> .tk-hub) {
      grid-column: 1;
      grid-row: 1;
      min-width: 0;
    }

    #MainContent:has(> .st-talks-section > .tk-hub) > .st-trules-section {
      grid-column: 2;
      grid-row: 1;
      align-self: stretch;
    }

    .tk-hub {
      max-width: none;
      padding: 32px 0 64px;
    }

    .tk-dock {
      display: none;
    }

    .tk .tk-wordmark {
      font-size: 52px;
    }

    .tk-promise {
      font-size: 17px;
    }

    .tk-label {
      font-size: 15px;
    }

    .tk-hub .tk-hero {
      margin-top: 16px;
    }
  }

  @media screen and (min-width: 1280px) {
    #MainContent:has(> .st-talks-section > .tk-hub) {
      grid-template-columns: 220px minmax(0, 720px) 300px;
    }

    #MainContent > .st-talks-section:has(> .tk-hub) {
      grid-column: 1 / 3;
      display: grid;
      grid-template-columns: subgrid;
    }

    #MainContent:has(> .st-talks-section > .tk-hub) > .st-trules-section {
      grid-column: 3;
    }

    .tk-hub {
      display: grid;
      grid-column: 1 / -1;
      grid-template-columns: subgrid;
    }

    .tk-hub > .tk-side {
      display: block;
      grid-column: 1;
    }

    .tk-hub > .tk-main {
      grid-column: 2;
      min-width: 0;
    }

    .tk-hub .tk-chips {
      display: none;
    }
  }

  @media screen and (min-width: 1680px) {
    #MainContent:has(> .st-talks-section > .tk-hub) {
      column-gap: 56px;
    }
  }

  /* ---------- any other blog on this template (news): unchanged plain rows ---------- */
  .st-talks {
    display: grid;
    max-width: 40rem;
    margin-inline: auto;
    padding: 73px 0 28px;
    color: #111;
    font-family: var(--font-ui);
  }

  .st-talks > * {
    min-width: 0;
  }

  .st-talks__header {
    display: grid;
    justify-items: center;
    padding-inline: 16px;
    text-align: center;
  }

  .st-talks__title {
    margin: 0;
    color: var(--st-burgundy);
    font-family: var(--font-shop-display);
    font-weight: 900;
    font-size: min(95px, 24.4vw);
    line-height: 1;
    letter-spacing: -0.06em;
  }

  @supports (background-clip: text) or (-webkit-background-clip: text) {
    .st-talks__title {
      background: linear-gradient(180deg, #8a0619 0%, #8a0619 30%, #a8081f 46%, #6a0212 74%, #4f0009 100%);
      -webkit-background-clip: text;
      background-clip: text;
      color: transparent;
    }
  }

  .st-talks__list {
    display: grid;
    margin: 4px 0 0;
    padding: 0;
    list-style: none;
  }

  .st-trow + .st-trow {
    border-block-start: 1px solid #efe9ea;
  }

  .st-trow__link {
    display: grid;
    grid-template-columns: 90px minmax(0, 1fr);
    align-items: start;
    gap: 20px;
    padding: 16px 20px 20px 18px;
    color: inherit;
    text-decoration: none;
  }

  .st-trow__text {
    display: grid;
    min-width: 0;
  }

  .st-trow__meta {
    display: flex;
    justify-content: space-between;
    gap: 8px;
    color: var(--st-muted-text);
    font-size: 15px;
    line-height: 1.3;
  }

  .st-trow__author {
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .st-trow__meta .st-ago {
    flex: none;
  }

  .st-trow__title {
    margin-block-start: 8px;
    color: #111;
    font-weight: 700;
    font-size: 22px;
    line-height: 1.1;
    letter-spacing: -0.01em;
  }

  a.st-trow__link:hover .st-trow__title {
    text-decoration: underline;
    text-underline-offset: 3px;
  }

  .st-trow__link:focus-visible,
  .st-talks__more-link:focus-visible {
    outline: 2px solid var(--st-burgundy);
    outline-offset: 3px;
  }

  .st-talks__more {
    display: flex;
    justify-content: center;
    gap: 12px;
    margin-block-start: 12px;
    padding-inline: 20px;
  }

  .st-talks__more-link {
    display: inline-flex;
    align-items: center;
    min-block-size: 44px;
    padding-inline: 24px;
    border: 2px solid var(--st-outline-red);
    border-radius: var(--st-radius-pill);
    color: var(--st-outline-red);
    font-family: var(--font-pill);
    font-weight: 600;
    font-size: 20px;
    text-decoration: none;
  }

  @media screen and (min-width: 750px) {
    .st-talks {
      padding-block-start: 80px;
    }
  }
{% endstylesheet %}
{% schema %}
{
  "name": "Small Talk the talks",
  "tag": "div",
  "class": "st-talks-section",
  "settings": [
    { "type": "text", "id": "blog_handle", "label": "Talks blog handle", "default": "the-talks", "info": "This blog's page is the talks hub (all threads)." },
    { "type": "text", "id": "hub_url", "label": "Hub link (for topic pages)", "default": "/blogs/the-talks" },
    { "type": "text", "id": "heading", "label": "Heading on topic pages (TLK-001)", "default": "the talks" },
    { "type": "text", "id": "tagline", "label": "Tagline (TLK-002)", "default": "a little less filtered.", "info": "Not shown in the talks v4 layout." },
    { "type": "text", "id": "subheading", "label": "Promise under the wordmark (TLK-003)", "default": "for the good days, and the other ones." },
    { "type": "text", "id": "cta_label", "label": "Phone button (TLK-004)", "default": "spill your tea ↗" },
    { "type": "text", "id": "all_label", "label": "Chip: all (TLK-005)", "default": "all" },
    { "type": "text", "id": "chip_order", "label": "Topic order (talk topic handles, comma-separated)", "default": "plot-twists, tiny-wins, second-opinions, just-venting, nail-talk", "info": "Topics not listed here follow in admin order." },
